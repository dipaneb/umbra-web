---
import Layout from '../layouts/Layout.astro';
import { getFaqs } from '../data/faq';
import { localizePath, type Lang } from '../i18n/utils';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const faqs = getFaqs(lang);

const copy = {
	en: {
		seoTitle: 'FAQ',
		seoDescription:
			'Is Umbra open source? Is it safe on Windows? Does it phone home? Direct answers to the most common questions.',
		lede: 'Common questions, answered directly.',
	},
	fr: {
		seoTitle: 'FAQ',
		seoDescription:
			'Umbra est-il open source ? Est-il sûr sous Windows ? Envoie-t-il des données ? Réponses directes aux questions les plus fréquentes.',
		lede: 'Questions courantes, avec une réponse directe.',
	},
} as const;

const c = copy[lang];

const toolLabels =
	lang === 'fr'
		? ['JSON', 'Base64', 'UUID', 'Hash', 'JWT', 'Cron', 'Image en texte', 'PDF', 'Images']
		: ['JSON', 'Base64', 'UUID', 'Hash', 'JWT', 'Cron', 'Image to Text', 'PDF', 'Images'];
const toolSlugs = ['json', 'base64', 'uuid', 'hash', 'jwt', 'cron', 'ocr', 'pdf', 'image'];
const compareLabels = ['DevToys', 'DevUtils', 'DevTools-X', 'CyberChef'];
const compareSlugs = ['devtoys', 'devutils', 'devtools-x', 'cyberchef'];
---

<Layout title={c.seoTitle} description={c.seoDescription}>
	<section class="section container prose faq-page">
		<h1>{c.seoTitle}</h1>
		<p class="page-lede">{c.lede}</p>

		<ul class="faq-list">
			{
				faqs.map((item) => (
					<li>
						<details id={item.id}>
							<summary><h2>{item.q}</h2></summary>
							{item.id === 'comparison-to-named-competitors' ? (
								<p class="answer">
									{lang === 'fr'
										? "En bref : Umbra met en avant une revendication précise qu'aucun des trois ne fait de la même façon — une vérification à chaque version montrant zéro appel réseau, pas seulement une phrase affirmant le respect de la vie privée. Les comparaisons complètes et sourcées sont disponibles sur leurs propres pages : "
										: 'The short version: Umbra leads with one narrow claim none of them make the same way — a per-release check showing zero network calls, not just a sentence asserting privacy. The full, sourced comparisons live on their own pages: '}
									{compareSlugs.map((slug, i) => (
										<>
											<a href={localizePath(`/compare/${slug}/`, lang)}>{compareLabels[i]}</a>
											{i < compareSlugs.length - 1 ? ', ' : '.'}
										</>
									))}
								</p>
							) : item.id === 'free-online-tools' ? (
								<p class="answer">
									{lang === 'fr'
										? "Parce que tout ce que vous collez dans un outil web quitte votre machine, même brièvement — vous faites confiance à un serveur que vous ne contrôlez pas et ne pouvez pas inspecter. Umbra fonctionne entièrement sur votre appareil : rien de ce que vous collez, déposez ou tapez n'est jamais envoyé ailleurs. Chaque outil a sa propre page avec plus de détails pour ce format précis : "
										: "Because anything you paste into a web tool leaves your machine, even briefly — you're trusting a server you don't control and can't inspect. Umbra runs entirely on your device: nothing you paste, drop, or type is ever sent anywhere. Each tool has its own page with more on this for that specific format: "}
									{toolSlugs.map((slug, i) => (
										<>
											<a href={localizePath(`/tools/${slug}/`, lang)}>{toolLabels[i]}</a>
											{i < toolSlugs.length - 1 ? ', ' : '.'}
										</>
									))}
								</p>
							) : (
								<p class="answer">{item.a}</p>
							)}
						</details>
					</li>
				))
			}
		</ul>
	</section>
</Layout>

<style>
	.faq-page {
		max-width: 42rem;
	}
</style>
