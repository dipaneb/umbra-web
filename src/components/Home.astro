---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { localizePath, type Lang } from '../i18n/utils';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;

// Single source for every tool's name/description/search-terms text (the
// content-collection refactor, landing-ia.md §5), read from this page's own
// locale subfolder (Step 6.5) — both this bento grid and the mobile
// horizontal-scroll strip below read it, keyed by id.
const tools = await getCollection('tools', ({ id }) => id.startsWith(`${lang}/`));
const byId = Object.fromEntries(tools.map((tool) => [tool.id.replace(`${lang}/`, ''), tool.data]));
const mobileTools = [...tools].sort((a, b) => a.data.order - b.data.order);

const copy = {
	en: {
		seoTitle: 'Local, Offline Developer Tools',
		seoDescription:
			'JSON, JWT, hashing, cron, and more — everyday developer tools that run entirely on your machine. Free, no account, no cloud.',
		heroH1a: 'Local tools. Local AI.',
		heroH1b: 'Nothing else.',
		heroLedeLines: ['The tools you reach for every day,', 'all bundled in one app,', 'fully offline.'],
		download: 'Download',
		videoAria:
			"Umbra demo: pressing ⌘K, formatting JSON, decoding a JWT, and building a cron schedule",
		toolsHeading: '9 tools',
		paletteHeadlineLines: ['Type it.', 'Find any tool.'],
		paletteAria: 'Search tools',
		workflowHeading: 'Every tool, one search away',
		workflowLede:
			'Press ⌘K from anywhere in Umbra. Format a JSON payload, decode a JWT, build a cron schedule — the same shortcut, every time, without breaking flow to open a new tool.',
		proofHeading: 'Verify it yourself',
		proofLeadStrong:
			"There's no server for your data to go to — with one disclosed exception, an automatic check for app updates.",
		proofLeadRest:
			'Umbra is a native app, not a client talking to a backend. What you paste, drop, or type is processed on the machine in front of you, by code running on that machine — there’s nothing to intercept, because there’s nowhere for it to go, except for that one exception: once, at launch, Umbra checks GitHub for a newer release, the single network call it ever makes, and nothing installs without you confirming it first.',
		diagramAria: 'Your machine, with no connection to any server',
		diagramMachine: 'Your machine',
		diagramServer: 'Server',
		proofArchitecture:
			'It’s built this way structurally, not by policy: a native Rust application, compiled to a single binary, with no client-server architecture underneath it for anything to route through in the first place.',
		proofSourcePre: 'The source is public — ',
		proofSourceLinkText: 'read it yourself',
		proofSourceMid:
			". Umbra's repository is source-available: open the networking layer and confirm this isn't just asserted. (Source-available isn't open source — you can view the code, not redistribute or reuse it. More on that ",
		proofSourceFaqLinkText: 'in the FAQ',
		proofSourceEnd: '.)',
		proofSigning:
			'The macOS build is signed with a Developer ID certificate and notarized by Apple, so it opens with no Gatekeeper warning on a clean install.',
		proofCheckStrong: "Don't take our word for it.",
		proofCheckRest: ' Quit and relaunch Umbra while this is running, on your own downloaded copy:',
		proofCheckCommand: 'nettop -p $(pgrep -x umbra)',
		proofCheckResult:
			"You'll see one connection — the update check, at launch — and nothing else, no matter which tool you use. (macOS only. Windows and Linux instructions aren't written yet.)",
		whyHeading: 'Why Umbra',
		whyItems: [
			{
				lead: 'Instant.',
				body: 'A native Rust app, not a browser tab — cold launch measured under 2 seconds, and kept there as new tools are added.',
			},
			{
				lead: 'However you work.',
				body: 'Full keyboard navigation and screen-reader-labeled controls, in every tool.',
			},
			{
				lead: 'Always your call.',
				body: 'Every update is a confirmation, not a background install. Nothing changes without you saying so.',
			},
			{
				lead: 'No strings attached.',
				body: 'Download and use it — no sign-up, no trial clock, no plan to pick.',
			},
		],
		availability: 'Available for macOS, Windows, and Linux.',
		faqAnchor: 'open-source-and-audit-status',
	},
	fr: {
		seoTitle: 'Outils de développement locaux et hors ligne',
		seoDescription:
			'JSON, JWT, hachage, cron, et plus — des outils du quotidien qui fonctionnent entièrement sur votre machine. Gratuit, sans compte, sans cloud.',
		heroH1a: 'Rien de ce que vous collez ne part jamais.',
		heroH1b: "Pas même pour l'IA.",
		heroLedeLines: ['Les outils que vous utilisez déjà,', 'tout réuni dans une app,', 'et toujours hors ligne.'],
		download: 'Télécharger',
		videoAria:
			"Démo d'Umbra : appui sur ⌘K, mise en forme d'un JSON, décodage d'un JWT, et création d'une tâche cron",
		toolsHeading: '9 outils',
		paletteHeadlineLines: ['Tapez.', "Trouvez n'importe quel outil."],
		paletteAria: 'Rechercher un outil',
		workflowHeading: 'Chaque outil, à une recherche près',
		workflowLede:
			"Appuyez sur ⌘K, depuis n'importe où dans Umbra. Mettez en forme un JSON, décodez un JWT, programmez une tâche cron — le même raccourci, à chaque fois, sans jamais perdre le fil.",
		proofHeading: 'Vérifiez-le vous-même',
		proofLeadStrong:
			"Il n'y a aucun serveur vers lequel vos données pourraient partir — à une exception près, assumée : la vérification automatique des mises à jour.",
		proofLeadRest:
			"Umbra est une application native, pas un client qui dialogue avec un serveur distant. Ce que vous collez, déposez ou tapez est traité sur la machine devant vous, par du code qui tourne sur cette machine — il n'y a rien à intercepter, puisqu'il n'y a nulle part où l'envoyer, à l'exception de celle-ci : une fois, au lancement, Umbra vérifie sur GitHub si une nouvelle version est disponible — le seul appel réseau qu'il effectue — et rien ne s'installe sans votre confirmation.",
		diagramAria: 'Votre machine, sans connexion à un serveur',
		diagramMachine: 'Votre machine',
		diagramServer: 'Serveur',
		proofArchitecture:
			"C'est une contrainte structurelle, pas un choix de politique : une application native en Rust, compilée en un seul binaire, sans architecture client-serveur sous-jacente vers laquelle quoi que ce soit pourrait transiter.",
		proofSourcePre: 'Le code source est public — ',
		proofSourceLinkText: 'vérifiez-le vous-même',
		proofSourceMid:
			". Le dépôt d'Umbra est source-available : vous pouvez ouvrir la couche réseau et constater que ce n'est pas qu'une affirmation. (« Source-available » n'est pas « open source » : vous pouvez consulter le code, pas le redistribuer ni le réutiliser — plus de détails ",
		proofSourceFaqLinkText: 'dans la FAQ',
		proofSourceEnd: '.)',
		proofSigning:
			"La version macOS est signée avec un certificat Developer ID et notarisée par Apple : elle s'ouvre sans avertissement Gatekeeper sur une installation neuve.",
		proofCheckStrong: 'Ne nous croyez pas sur parole.',
		proofCheckRest: ' Quittez puis relancez Umbra pendant que cette commande tourne, sur votre propre copie téléchargée :',
		proofCheckCommand: 'nettop -p $(pgrep -x umbra)',
		proofCheckResult:
			"Vous ne verrez qu'une connexion — la vérification de mise à jour, au lancement — et rien d'autre, quel que soit l'outil utilisé. (macOS uniquement. Les instructions pour Windows et Linux ne sont pas encore rédigées.)",
		whyHeading: 'Pourquoi Umbra',
		whyItems: [
			{
				lead: 'Instantané.',
				body: "Une application native en Rust, pas un onglet de navigateur — lancement mesuré à moins de 2 secondes, et maintenu à ce niveau à mesure que de nouveaux outils sont ajoutés.",
			},
			{
				lead: 'Adapté à chacun.',
				body: "Navigation complète au clavier et commandes étiquetées pour les lecteurs d'écran, sur chaque outil.",
			},
			{
				lead: 'Toujours votre décision.',
				body: 'Chaque mise à jour est une confirmation, jamais une installation silencieuse. Rien ne change sans votre accord.',
			},
			{
				lead: 'Sans engagement.',
				body: "Téléchargez-le et utilisez-le — pas d'inscription, pas de période d'essai, pas de formule à choisir.",
			},
		],
		availability: 'Disponible pour macOS, Windows et Linux.',
		faqAnchor: 'open-source-and-audit-status',
	},
} as const;

const c = copy[lang];
const videoBase = `/videos/workflow-demo.${lang}`;

// SoftwareApplication JSON-LD (Step 6.6). Deliberately omits `softwareVersion`
// and `datePublished` — ledger row 10 (landing-strategy.md §5) forbids
// hardcoding a version anywhere in site copy or build config, and `downloadUrl`
// below points at the same never-versioned `/releases/latest` GitHub endpoint
// Download.astro's own buttons use, for the same reason. Also deliberately
// omits `aggregateRating`/`review` — Google requires one of them for the
// SoftwareApplication rich result, but fabricating either would break Step
// 3.5's "no fabricated stat, star, or testimonial" finding; this markup ships
// without rich-result eligibility rather than invent one.
const softwareApplicationJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareApplication',
	name: 'Umbra',
	url: new URL(Astro.url.pathname, Astro.site).toString(),
	description: c.seoDescription,
	inLanguage: lang === 'fr' ? 'fr-FR' : 'en-US',
	applicationCategory: 'DeveloperApplication',
	operatingSystem: 'macOS, Windows, Linux',
	downloadUrl: 'https://github.com/dipaneb/umbra/releases/latest',
	sameAs: 'https://github.com/dipaneb/umbra',
	license: new URL(localizePath('/eula/', lang), Astro.site).toString(),
	offers: {
		'@type': 'Offer',
		price: '0',
		priceCurrency: 'EUR',
	},
};
---

<Layout title={c.seoTitle} description={c.seoDescription}>
	<script type="application/ld+json" set:html={JSON.stringify(softwareApplicationJsonLd).replace(/</g, '\\u003c')} />

	<section class="hero" id="hero">
		<div class="hero-text">
			<h1>{c.heroH1a}<br />{c.heroH1b}</h1>
			<p class="lede">{c.heroLedeLines.map((line, i) => (<>{line}{i < c.heroLedeLines.length - 1 && <br />}</>))}</p>
			<a class="button" href={localizePath('/download/', lang)} data-analytics="download_clicked">{c.download}</a>
		</div>
		<div class="hero-media container">
			<video
				class="hero-video"
				controls
				muted
				preload="none"
				poster={`${videoBase}.poster.jpg`}
				width="960"
				height="540"
				aria-label={c.videoAria}
			>
				<source src={`${videoBase}.webm`} type="video/webm" />
				<source src={`${videoBase}.mp4`} type="video/mp4" />
			</video>
		</div>
	</section>

	<section class="section tools container" aria-labelledby="tools-heading">
		<h2 id="tools-heading">{c.toolsHeading}</h2>

		<!-- Bento grid — desktop (4-col) and tablet (3-col reflow), landing-design.md §2.
		     The search bar lives inside the palette tile itself, not as a separate
		     element above the grid — one command-palette-styled box, not two. -->
		<div class="bento-grid">
			<a class="tile on-light tile-json" data-tool-name={byId.json.searchTerms} href={localizePath('/tools/json/', lang)}>
				<span class="ghost" aria-hidden="true">{'{ }'}</span>
				<div class="tile-content">
					<h3 class="tile-name">{byId.json.name}</h3>
					<p class="tile-desc">{byId.json.tileDescription}</p>
				</div>
			</a>

			<div class="tile on-default tile-palette">
				<input id="tool-search" class="palette-input" type="text" placeholder="⌘K" aria-label={c.paletteAria} />
				<h3 class="tile-name tile-name-display">{c.paletteHeadlineLines.map((line, i) => (<>{line}{i < c.paletteHeadlineLines.length - 1 && <br />}</>))}</h3>
			</div>

			<a class="tile on-accent tile-hash" data-tool-name={byId.hash.searchTerms} href={localizePath('/tools/hash/', lang)}>
				<span class="ghost ghost-on-accent" aria-hidden="true">#</span>
				<div class="tile-content">
					<h3 class="tile-name">{byId.hash.name}</h3>
					<p class="tile-desc">{byId.hash.tileDescription}</p>
				</div>
			</a>

			<a class="tile on-light tile-uuid tile-square" data-tool-name={byId.uuid.searchTerms} href={localizePath('/tools/uuid/', lang)}>
				<svg class="icon" aria-hidden="true" viewBox="0 0 24 24" stroke="currentColor"><rect x="3" y="5" width="18" height="14" rx="2"></rect><circle cx="8" cy="12" r="2"></circle><line x1="13" y1="9" x2="18" y2="9"></line><line x1="13" y1="15" x2="16" y2="15"></line></svg>
				<h3 class="tile-name tile-name-sm">{byId.uuid.name}</h3>
			</a>

			<a class="tile on-light tile-jwt tile-square" data-tool-name={byId.jwt.searchTerms} href={localizePath('/tools/jwt/', lang)}>
				<svg class="icon" aria-hidden="true" viewBox="0 0 24 24" stroke="currentColor"><circle cx="8" cy="12" r="4"></circle><line x1="12" y1="12" x2="21" y2="12"></line><line x1="17" y1="12" x2="17" y2="16"></line><line x1="21" y1="12" x2="21" y2="16"></line></svg>
				<h3 class="tile-name tile-name-sm">{byId.jwt.name}</h3>
			</a>

			<a class="tile on-light tile-base64" data-tool-name={byId.base64.searchTerms} href={localizePath('/tools/base64/', lang)}>
				<svg class="icon" aria-hidden="true" viewBox="0 0 24 24" stroke="currentColor"><path d="M3 8h13l-3.5-3.5M3 8l3.5 3.5M21 16H8l3.5-3.5M21 16l-3.5 3.5"></path></svg>
				<h3 class="tile-name">{byId.base64.name}</h3>
				<p class="tile-desc">{byId.base64.tileDescription}</p>
			</a>

			<a class="tile on-light tile-cron" data-tool-name={byId.cron.searchTerms} href={localizePath('/tools/cron/', lang)}>
				<svg class="icon" aria-hidden="true" viewBox="0 0 24 24" stroke="currentColor"><circle cx="12" cy="12" r="8.5"></circle><line x1="12" y1="12" x2="12" y2="7"></line><line x1="12" y1="12" x2="15.5" y2="14"></line></svg>
				<h3 class="tile-name">{byId.cron.name}</h3>
				<p class="tile-desc">{byId.cron.tileDescription}</p>
			</a>

			<a class="tile on-light tile-ocr" data-tool-name={byId.ocr.searchTerms} href={localizePath('/tools/ocr/', lang)}>
				<svg class="icon" aria-hidden="true" viewBox="0 0 24 24" stroke="currentColor"><path d="M4 8V5a1 1 0 0 1 1-1h3M20 8V5a1 1 0 0 0-1-1h-3M4 16v3a1 1 0 0 0 1 1h3M20 16v3a1 1 0 0 1-1 1h-3"></path><line x1="8" y1="10" x2="16" y2="10"></line><line x1="8" y1="14" x2="14" y2="14"></line></svg>
				<h3 class="tile-name">{byId.ocr.name}</h3>
				<p class="tile-desc">{byId.ocr.tileDescription}</p>
			</a>

			<a class="tile on-light tile-pdf" data-tool-name={byId.pdf.searchTerms} href={localizePath('/tools/pdf/', lang)}>
				<svg class="icon" aria-hidden="true" viewBox="0 0 24 24" stroke="currentColor"><path d="M6 3h9l4 4v14a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z"></path><path d="M15 3v4h4"></path><line x1="8" y1="13" x2="16" y2="13"></line><line x1="8" y1="16.5" x2="16" y2="16.5"></line></svg>
				<h3 class="tile-name">{byId.pdf.name}</h3>
				<p class="tile-desc">{byId.pdf.tileDescription}</p>
			</a>

			<a
				class="tile on-light tile-images"
				data-tool-name={byId.image.searchTerms}
				href={localizePath('/tools/image/', lang)}
			>
				<svg class="icon icon-lg" aria-hidden="true" viewBox="0 0 24 24" stroke="currentColor"><rect x="3" y="4" width="18" height="16" rx="2"></rect><circle cx="8.5" cy="9.5" r="1.75"></circle><path d="M21 16l-5.5-5.5a1 1 0 0 0-1.4 0L6 19"></path></svg>
				<div class="tile-images-text"><h3 class="tile-name">{byId.image.name}</h3><p class="tile-desc">{byId.image.tileDescription}</p></div>
				<div class="tile-images-tags">
					<span class="tag tag-neutral">PNG</span><span class="tag tag-neutral">JPEG</span><span class="tag tag-neutral">WebP</span><span class="tag tag-neutral">AVIF</span>
				</div>
			</a>
		</div>

		<!-- Mobile horizontal-scroll strip — landing-design.md §2, confirmed unchanged for <768px -->
		<ul class="mobile-strip">
			{
				mobileTools.map((tool) => {
					const slug = tool.id.replace(`${lang}/`, '');
					return (
						<li class="mobile-strip-card" data-tool-name={tool.data.searchTerms}>
							<a class="card-link" href={localizePath(`/tools/${slug}/`, lang)}>
								<span class="tool-icon" aria-hidden="true">
									{tool.data.icon}
								</span>
								<h3>{tool.data.name}</h3>
							</a>
						</li>
					);
				})
			}
		</ul>
	</section>

	<section class="section section-alt workflow container" aria-labelledby="workflow-heading">
		<div class="workflow-copy">
			<h2 id="workflow-heading">{c.workflowHeading}</h2>
			<p class="section-lede">{c.workflowLede}</p>
		</div>
		<video
			class="workflow-video"
			controls
			muted
			preload="none"
			poster={`${videoBase}.poster.jpg`}
			width="960"
			height="540"
			aria-label={c.videoAria}
		>
			<source src={`${videoBase}.webm`} type="video/webm" />
			<source src={`${videoBase}.mp4`} type="video/mp4" />
		</video>
	</section>

	<section class="section proof container" aria-labelledby="proof-heading">
		<h2 id="proof-heading">{c.proofHeading}</h2>
		<p class="proof-lead">
			<strong>{c.proofLeadStrong}</strong> {c.proofLeadRest}
		</p>

		<div class="diagram" role="img" aria-label={c.diagramAria}>
			<span class="diagram-box">{c.diagramMachine}</span>
			<span class="diagram-x" aria-hidden="true">✕</span>
			<span class="diagram-box diagram-box-muted">{c.diagramServer}</span>
		</div>

		<p>{c.proofArchitecture}</p>

		<p>
			{c.proofSourcePre}
			<a href="https://github.com/dipaneb/umbra">{c.proofSourceLinkText}</a>
			{c.proofSourceMid}
			<a href={`${localizePath('/faq/', lang)}#${c.faqAnchor}`}>{c.proofSourceFaqLinkText}</a>
			{c.proofSourceEnd}
		</p>

		<p>{c.proofSigning}</p>

		<!-- Self-check terminal — hidden on mobile: a phone can't run this or install the
		     binary it's checking (landing-design.md §2, confirmed 2026-09-22). -->
		<div class="proof-selfcheck">
			<p class="proof-checkline"><strong>{c.proofCheckStrong}</strong>{c.proofCheckRest}</p>
			<pre class="proof-command"><code>{c.proofCheckCommand}</code></pre>
			<p>{c.proofCheckResult}</p>
		</div>
	</section>

	<section class="section section-alt why container" aria-labelledby="why-heading">
		<h2 id="why-heading">{c.whyHeading}</h2>
		<ul class="why-grid">
			{
				c.whyItems.map((item) => (
					<li>
						<strong>{item.lead}</strong> {item.body}
					</li>
				))
			}
		</ul>
	</section>

	<section class="section closing-cta container">
		<a class="button" href={localizePath('/download/', lang)} data-analytics="download_clicked">{c.download}</a>
		<p class="availability">{c.availability}</p>
	</section>
</Layout>

<script is:inline>
	(function () {
		// Live-filtering search — dims/greys non-matching tiles and outlines
		// matches in the signature accent, across the bento grid (desktop/
		// tablet) and the mobile strip alike (landing-design.md §2).
		var input = document.getElementById('tool-search');
		var tiles = Array.prototype.slice.call(document.querySelectorAll('[data-tool-name]'));
		if (input) {
			input.addEventListener('input', function () {
				var q = input.value.trim().toLowerCase();
				tiles.forEach(function (tile) {
					var hay = (tile.getAttribute('data-tool-name') || '').toLowerCase();
					var match = q === '' || (hay !== '' && hay.indexOf(q) !== -1);
					tile.style.opacity = match ? '1' : '0.3';
					tile.style.filter = match ? 'none' : 'grayscale(70%)';
					tile.style.outline = match && q !== '' && hay !== '' ? '2px solid var(--accent-signature)' : 'none';
					tile.style.outlineOffset = '2px';
				});
			});
		}

		// Nav Download button hides while the hero (which carries its own,
		// more prominent CTA) is in view, per landing-design.md §2.
		var hero = document.getElementById('hero');
		var navBtn = document.getElementById('nav-download-btn');
		if (hero && navBtn) {
			var observer = new IntersectionObserver(
				function (entries) {
					entries.forEach(function (entry) {
						navBtn.style.opacity = entry.isIntersecting ? '0' : '1';
						navBtn.style.pointerEvents = entry.isIntersecting ? 'none' : 'auto';
					});
				},
				{ threshold: 0.2 },
			);
			observer.observe(hero);
		}
	})();
</script>

<style>
	.hero {
		padding: var(--space-section-lg) var(--space-6);
		text-align: center;
	}

	.hero-text {
		max-width: 46rem;
		margin: 0 auto;
	}

	.hero h1 {
		font-family: var(--font-display);
		font-size: var(--type-hero);
		line-height: 1.05;
		letter-spacing: -0.02em;
		margin: 0 0 var(--space-4);
	}

	.lede {
		font-size: var(--type-body-lead);
		color: var(--text-secondary);
		margin: 0 0 var(--space-8);
	}

	.hero-media {
		margin-top: var(--space-10);
	}

	.hero-video {
		display: block;
		width: 100%;
		border-radius: var(--radius-lg);
		border: 1px solid var(--border-hairline);
	}

	.section-alt {
		background: var(--bg-surface);
		border-top: 1px solid var(--border-hairline);
		border-bottom: 1px solid var(--border-hairline);
	}

	/* Bento grid — asymmetric, tight gaps, semantic-role tiles so dark mode
	   inverts correctly (landing-design.md §2/§6). Desktop: 4 columns. */
	.bento-grid {
		margin-top: var(--space-8);
		display: grid;
		gap: 12px;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		grid-template-areas:
			'json    palette palette hash'
			'json    uuid    jwt     hash'
			'base64  cron    ocr     pdf'
			'images  images  images  images';
	}

	.tile {
		border-radius: 6px;
		box-sizing: border-box;
		position: relative;
		overflow: hidden;
		display: block;
		text-decoration: none;
		transition: transform 0.15s ease, opacity 0.15s ease, filter 0.15s ease, outline-color 0.15s ease;
	}

	a.tile:hover {
