---
import Layout from '../layouts/Layout.astro';
import { useTranslations, localizePath, type Lang } from '../i18n/utils';

interface Row {
	label: string;
	umbra: string;
	competitor: string;
}

interface Competitor {
	name: string;
	slug: string;
}

interface Props {
	lang: Lang;
	title: string;
	description: string;
	competitorName: string;
	intro: string;
	rows: Row[];
	verdict: string;
	others: Competitor[];
}

const { lang, title, description, competitorName, intro, rows, verdict, others } = Astro.props;
const t = useTranslations(lang);
---

<Layout title={title} description={description}>
	<section class="section container prose compare-page">
		<h1>Umbra vs. {competitorName}</h1>
		<p class="page-lede">{intro}</p>

		<table class="compare-table">
			<thead>
				<tr>
					<th scope="col"></th>
					<th scope="col">Umbra</th>
					<th scope="col">{competitorName}</th>
				</tr>
			</thead>
			<tbody>
				{
					rows.map((row) => (
						<tr>
							<th scope="row">{row.label}</th>
							<td>{row.umbra}</td>
							<td>{row.competitor}</td>
						</tr>
					))
				}
			</tbody>
		</table>

		<p>{verdict}</p>

		<a class="button" href={localizePath('/download/', lang)} data-analytics="download_clicked">{t('cta.download')}</a>

		<div class="cross-links">
			<p>{t('cta.crossLinkIntro')}</p>
			<ul>
				{
					others.map((c) => (
						<li>
							<a href={localizePath(`/compare/${c.slug}/`, lang)}>{c.name}</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>
</Layout>

<style>
	.compare-page {
		max-width: 44rem;
	}

	.compare-page .button {
		margin: var(--space-6) 0 var(--space-10);
		display: inline-block;
	}

	.cross-links {
		border-top: 1px solid var(--border-hairline);
		padding-top: var(--space-6);
	}

	.cross-links ul {
		list-style: none;
		padding: 0;
		display: flex;
		gap: var(--space-4);
	}
</style>
