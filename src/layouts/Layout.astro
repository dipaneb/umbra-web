---
import { Font } from 'astro:assets';

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
	/** Use `title` verbatim as the full <title> tag, skipping the Home/other-page
	 * wrapping convention below — for the two pages (Download, About) whose
	 * locked SEO title already reads naturally with "Umbra" mid-string rather
	 * than as a " — Umbra" suffix (landing-copy.md §7 Part 1). */
	rawTitle?: boolean;
}

const {
	title = 'Home',
	description = 'Umbra: privacy-first developer tools that don\'t phone home.',
	noindex = false,
	rawTitle = false,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const isProd = import.meta.env.PROD;
const isHome = Astro.url.pathname === '/';
// Home is the brand — `Umbra — {value}`; every other page is `{value} — Umbra` (landing-copy.md §7).
const pageTitle = rawTitle ? title : isHome ? `Umbra — ${title}` : `${title} — Umbra`;

const isCurrent = (href: string) => Astro.url.pathname === href || Astro.url.pathname === `${href}/`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />

		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		{noindex && <meta name="robots" content="noindex, follow" />}

		<meta property="og:type" content="website" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />

		<!-- Hubot Sans/Geist Sans are used above the fold on every page (hero
		     or page title, plus body copy); Geist Mono only appears inside
		     occasional inline <code>, so it isn't preloaded. -->
		<Font cssVariable="--font-hubot-sans" preload />
		<Font cssVariable="--font-geist-sans" preload />
		<Font cssVariable="--font-geist-mono" />

		<!--
			PostHog: page-view analytics for this site only (never the Umbra
			app itself — AC3/INV-2). Session recording and autocapture are
			both off, so the only signal collected is "a page was viewed" —
			matching this footer's own disclosure below.

			This is PostHog's Project API Key (public, client-side by design
			— safe to ship in page source, unlike a Personal API Key). EU
			region project, hence the eu.i.posthog.com host below.

			Only loaded on production builds (isProd guard) — local `astro
			dev` sessions and Vercel preview deploys don't pollute
			production page-view counts.
		-->
		{isProd && (
		<script is:inline>
			!(function (t, e) {
				var o, n, p, r;
				e.__SV ||
					((window.posthog = e),
					(e._i = []),
					(e.init = function (i, s, a) {
						function g(t, e) {
							var o = e.split('.');
							2 == o.length && ((t = t[o[0]]), (e = o[1])),
								(t[e] = function () {
									t.push([e].concat(Array.prototype.slice.call(arguments, 0)));
								});
						}
						((p = t.createElement('script')).type = 'text/javascript'),
							(p.crossOrigin = 'anonymous'),
							(p.async = !0),
							(p.src =
								s.api_host.replace('.i.posthog.com', '-assets.i.posthog.com') + '/static/array.js'),
							(r = t.getElementsByTagName('script')[0]).parentNode.insertBefore(p, r);
						var u = e;
						for (
							void 0 !== a ? (u = e[a] = []) : (a = 'posthog'),
								u.people = u.people || [],
								u.toString = function (t) {
									var e = 'posthog';
									return 'posthog' !== a && (e += '.' + a), t || (e += ' (stub)'), e;
								},
								u.people.toString = function () {
									return u.toString(1) + '.people (stub)';
								},
								o =
									'init capture register register_once register_for_session unregister unregister_for_session getFeatureFlag getFeatureFlagPayload isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey getNextSurveyStep identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException loadToolbar get_property getSessionProperty createPersonProfile opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing debug'.split(
										' ',
									),
								n = 0;
							n < o.length;
							n++
						)
							g(u, o[n]);
						e._i.push([i, s, a]);
					}),
					(e.__SV = 1));
			})(document, window.posthog || []);
			posthog.init('phc_qFffTVrdyHuB6yyzY5mSFbjWHAMD2t7M9aid2ySCQ9fL', {
				api_host: 'https://eu.i.posthog.com',
				autocapture: false,
				disable_session_recording: true,
			});
		</script>
		)}
	</head>
	<body>
		<header class="site-header">
			<nav class="site-nav" aria-label="Primary">
				<a class="brand" href="/">
					<img class="brand-mark" src="/favicon.svg" width="24" height="24" alt="" />
					Umbra
				</a>
				<input type="checkbox" id="nav-toggle" class="nav-toggle-input" aria-hidden="true" />
				<ul class="nav-links">
					<li><a href="/tools/" aria-current={isCurrent('/tools') ? 'page' : undefined}>Tools</a></li>
					<li><a href="/faq/" aria-current={isCurrent('/faq') ? 'page' : undefined}>FAQ</a></li>
					<li><a href="/about/" aria-current={isCurrent('/about') ? 'page' : undefined}>About</a></li>
				</ul>
				<div class="nav-actions">
					<a
						id="nav-download-btn"
						href="/download/"
						class="cta"
						aria-current={isCurrent('/download') ? 'page' : undefined}
						data-analytics="download_clicked"
					>
						Download
					</a>
					<label for="nav-toggle" class="nav-toggle-label" aria-label="Menu">
						<span></span><span></span><span></span>
					</label>
				</div>
			</nav>
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<img class="footer-mark" src="/favicon.svg" width="20" height="20" alt="" loading="lazy" decoding="async" />
			<nav class="footer-links" aria-label="Footer">
				<a href="/faq/">FAQ</a>
				<a href="/privacy/">Privacy</a>
				<a href="/legal/">Legal notice</a>
				<a href="/eula/">EULA</a>
				<a href="/changelog/">Changelog</a>
				<a href="/about/">About</a>
			</nav>
			<p class="footer-compare">
				Compare: <a href="/compare/devtoys/">DevToys</a> · <a href="/compare/devutils/">DevUtils</a> ·{' '}
				<a href="/compare/devtools-x/">DevTools-X</a> · <a href="/compare/cyberchef/">CyberChef</a>
			</p>
			<!-- TODO(developer): real name — CLAUDE.md's privacy rule blocks committing one here;
			     see landing-copy.md §4 "About" section for the intended wording. -->
			<p>Hey — I'm the developer, the one person building and maintaining Umbra.</p>
			<p>
				Umbra collects anonymous page-view and download-intent analytics only. No cookies, no session
				recording.
			</p>
			<p>Source-available, not open source. See the <a href="/eula/">EULA</a>.</p>
			<p>
				<a href="https://github.com/dipaneb/umbra" data-analytics="notify_me_clicked">Watch on GitHub</a>{' '}
				to get notified about new releases.
			</p>
			<p class="footer-copyright">© 2026 Umbra.</p>
		</footer>

		<!--
			Delegated analytics click handler (AC3/INV-2 event plan, landing-strategy.md §4).
			Any element with `data-analytics="event_name"` fires that PostHog event on click;
			`data-analytics-props='{"key":"value"}'` is merged in as event properties. Delegated
			at document level so it also covers elements injected by page-level scripts (e.g. the
			download page's live per-platform buttons).
		-->
		<script is:inline>
			function guessPlatform() {
				var ua = navigator.userAgent;
				if (/Mac/.test(ua)) return 'macos';
				if (/Win/.test(ua)) return 'windows';
				if (/Linux/.test(ua)) return 'linux';
				return 'unknown';
			}

			document.addEventListener('click', function (event) {
				var el = event.target.closest('[data-analytics]');
				if (!el || !window.posthog) return;
				var props = {};
				if (el.dataset.analyticsProps) {
					try {
						props = JSON.parse(el.dataset.analyticsProps);
					} catch (e) {
						/* malformed props — send the event without them rather than drop it */
					}
				}
				// Nav/hero/closing-CTA "Download" links go to /download rather than a specific
				// asset, so they don't know which platform yet — best-effort guess from the UA,
				// same purpose ledger row 7's live per-platform logic serves on /download itself.
				if (el.dataset.analytics === 'download_clicked' && !props.platform) {
					props.platform = guessPlatform();
				}
				window.posthog.capture(el.dataset.analytics, props);
			});
		</script>
	</body>
</html>

<style is:global>
	/*
	 * Design tokens (Step 6.2). Colors are DESIGN.md's app palette, carried
	 * over unchanged (landing-design.md §1's own scope was type/spacing/
	 * breakpoints only, not a new color decision) and wired here as
	 * `prefers-color-scheme`-gated custom properties — the mechanism
	 * landing-design.md §6 confirms is the right one for this site (no
	 * Settings surface, so no need for the app's manual [data-theme]
	 * override layer). Type scale, spacing extensions, and radius all come
	 * from landing-design.md §1.
	 *
	 * Breakpoints (landing-design.md §1) are documented here for reference
	 * but used as literal px values in @media rules below — CSS custom
	 * properties cannot appear inside a media query condition:
	 *   --bp-md: 768px · --bp-lg: 1024px · --bp-xl: 1280px
	 */
	:root {
		/* Color — light (DESIGN.md) */
		--bg-base: #f4f5f6;
		--bg-surface: #ffffff;
		--bg-surface-raised: #ffffff;
		--border-hairline: rgba(16, 17, 19, 0.07);
		--text-primary: #18181b;
		--text-secondary: #5b5f66;
		--text-tertiary: #606266;
		--accent-signature: #ff5e1a;
		--accent-signature-on-text: #b64a07;
		--accent-signature-tint: rgba(255, 94, 26, 0.12);
		--accent-default: #18181b;
		--accent-default-on: #ffffff;
		--accent-destructive: #cf3130;
		--accent-neutral-chip: #e4e5e7;

		/* Shape */
		--radius-sm: 0.125rem; /* 2px */
		--radius-default: 0.25rem; /* 4px */
		--radius-lg: 0.5rem; /* 8px */
		--radius-full: 9999px;

		/* Spacing — DESIGN.md's 4px unit, extended upward for page rhythm */
		--space-1: 0.25rem; /* 4px */
		--space-2: 0.5rem; /* 8px */
		--space-3: 0.75rem; /* 12px */
		--space-4: 1rem; /* 16px */
		--space-5: 1.25rem; /* 20px */
		--space-6: 1.5rem; /* 24px */
		--space-8: 2rem; /* 32px */
		--space-10: 2.5rem; /* 40px */
		--space-12: 3rem; /* 48px */
		--space-16: 4rem; /* 64px */
		--space-20: 5rem; /* 80px */
		--space-24: 6rem; /* 96px */
		--space-32: 8rem; /* 128px */
		--space-section: clamp(3rem, 1.944rem + 4.507vw, 6rem);
		--space-section-lg: clamp(4rem, 2.592rem + 6.009vw, 8rem);

		/* Type — families (self-hosted via Astro's Fonts API, see <Font> tags) */
		--font-sans: var(--font-geist-sans), system-ui, sans-serif;
		--font-mono: var(--font-geist-mono), ui-monospace, monospace;
		--font-display: var(--font-hubot-sans), var(--font-geist-sans), sans-serif;

		/* Type — fluid scale, 375px→1440px reference viewport (landing-design.md §1) */
		--type-hero: clamp(2.25rem, 1.634rem + 2.629vw, 4rem);
		--type-h1: clamp(1.875rem, 1.567rem + 1.315vw, 2.75rem);
		--type-h2: clamp(1.375rem, 1.155rem + 0.939vw, 2rem);
		--type-h3: clamp(1.125rem, 1.037rem + 0.376vw, 1.375rem);
		--type-body-lead: clamp(1.125rem, 1.037rem + 0.376vw, 1.375rem);
		--type-body: clamp(1rem, 0.956rem + 0.188vw, 1.125rem);
		--type-label: 0.8125rem;
		--type-caption: 0.75rem;
		--type-code: 0.875rem;

		--max-width: 72rem;
	}

	@media (prefers-color-scheme: dark) {
		:root {
			--bg-base: #141415;
			--bg-surface: #1d1d1f;
			--bg-surface-raised: #28282b;
			--border-hairline: rgba(255, 255, 255, 0.07);
			--text-primary: #ededed;
			--text-secondary: #9a9da3;
			--text-tertiary: #a6a8ab;
			--accent-signature: #ff6e30;
			/* Already clears AA as text in dark mode — no separate on-text
			   value needed (DESIGN.md), so this just tracks the signature. */
			--accent-signature-on-text: #ff6e30;
			--accent-signature-tint: rgba(255, 110, 48, 0.16);
			--accent-default: #ededed;
			--accent-default-on: #141415;
			--accent-destructive: #f2665c;
			--accent-neutral-chip: #2c2c2f;
		}
	}

	/*
	 * `<html>` must keep its font-size at the browser default (100%) — every
	 * type size above is authored in rem specifically so it honors a
	 * visitor's browser text-size preference (WCAG 1.4.4). Do not add an
	 * `html { font-size: ... }` override (landing-design.md §1's guardrail).
	 */
	* {
		box-sizing: border-box;
	}

	/* The download page toggles the `hidden` attribute via JS on elements
	   (like .button) that set their own `display` — without this, that
	   class's display value wins the cascade over the UA's [hidden] rule. */
	[hidden] {
		display: none !important;
	}

	html,
	body {
		margin: 0;
		padding: 0;
	}

	body {
		font-family: var(--font-sans);
		font-size: var(--type-body);
		font-weight: 400;
		line-height: 1.6;
		color: var(--text-primary);
		background: var(--bg-base);
	}

	main {
		display: block;
	}

	h1,
	h2,
	h3 {
		font-family: var(--font-display);
		font-weight: 700;
		margin: 0;
	}

	h1 {
		font-size: var(--type-h1);
		line-height: 1.15;
		letter-spacing: -0.01em;
	}

	h2 {
		font-size: var(--type-h2);
		line-height: 1.25;
		letter-spacing: -0.01em;
	}

	h3 {
		font-family: var(--font-sans);
		font-size: var(--type-h3);
		font-weight: 600;
		line-height: 1.3;
	}

	code,
	pre {
		font-family: var(--font-mono);
		font-size: var(--type-code);
	}

	a {
		color: var(--accent-signature-on-text);
	}

	a:focus-visible,
	button:focus-visible {
		outline: 3px solid var(--accent-signature);
		outline-offset: 2px;
	}

	/* Shared page-building blocks (Step 6.3) — kept here rather than
	   redeclared per page, since every page in the Phase 2 inventory reuses
	   the same container/section/button/prose/card-grid shapes. */
	.container {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 0 var(--space-6);
	}

	.section {
		padding: var(--space-section) 0;
	}

	.section > h1,
	.section > h2 {
		text-align: center;
	}

	.section-lede {
		max-width: 40rem;
		margin: var(--space-3) auto 0;
		color: var(--text-secondary);
		text-align: center;
	}

	.button {
		display: inline-block;
		background: var(--accent-signature);
		color: #ffffff;
		text-decoration: none;
		font-weight: 600;
		padding: 0.75rem 1.5rem;
		border-radius: var(--radius-default);
		border: none;
		font-size: var(--type-body);
		font-family: var(--font-sans);
		cursor: pointer;
	}

	.button:hover {
		opacity: 0.9;
		color: #ffffff;
	}

	.button-secondary {
		display: inline-block;
		background: transparent;
		color: var(--text-primary);
		text-decoration: none;
		font-weight: 600;
		padding: 0.75rem 1.5rem;
		border-radius: var(--radius-default);
		border: 1px solid var(--border-hairline);
	}

	.button-secondary:hover {
		border-color: var(--accent-signature);
		color: var(--accent-signature-on-text);
	}

	.prose h1 {
		font-size: var(--type-h1);
		margin-bottom: var(--space-2);
	}

	.prose .page-lede {
		color: var(--text-secondary);
		font-size: var(--type-body-lead);
		margin: 0 0 var(--space-10);
	}

	.prose h2 {
		font-size: var(--type-h3);
		margin: var(--space-10) 0 var(--space-3);
	}

	.prose p,
	.prose ul,
	.prose ol {
		margin: 0 0 var(--space-4);
		color: var(--text-secondary);
	}

	.prose strong {
		color: var(--text-primary);
	}

	.prose a {
		text-decoration: underline;
	}

	/* .prose a's underline is for inline body links only — it must not
	   bleed onto button-styled anchors (e.g. a tool/compare page's Download
	   CTA, which lives inside a .prose container). */
	.prose a.button,
	.prose a.button-secondary,
	.prose a.card-link {
		text-decoration: none;
	}

	.prose code {
		background: var(--bg-surface);
		border: 1px solid var(--border-hairline);
		border-radius: var(--radius-sm);
		padding: 0.1rem 0.35rem;
	}

	.card-grid {
		list-style: none;
		margin: var(--space-10) 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
		gap: var(--space-5);
	}

	.card {
		border: 1px solid var(--border-hairline);
		border-radius: var(--radius-lg);
		padding: var(--space-5);
		background: var(--bg-surface);
		transition: transform 0.15s ease;
	}

	.card:hover {
		transform: translateY(-2px);
	}

	.card h3 {
		margin: 0 0 var(--space-2);
		font-size: 1.05rem;
	}

	.card p {
		margin: 0;
		color: var(--text-secondary);
		font-size: 0.92rem;
	}

	.card a.card-link {
		text-decoration: none;
		color: inherit;
		display: block;
	}

	.card a.card-link:hover h3 {
		color: var(--accent-signature-on-text);
	}

	.compare-table {
		width: 100%;
		border-collapse: collapse;
		margin: var(--space-6) 0;
		font-size: var(--type-body);
	}

	.compare-table caption {
		text-align: left;
		color: var(--text-secondary);
		margin-bottom: var(--space-3);
	}

	.compare-table th,
	.compare-table td {
		border: 1px solid var(--border-hairline);
		padding: var(--space-3) var(--space-4);
		text-align: left;
		vertical-align: top;
	}

	.compare-table thead th {
		background: var(--bg-surface);
	}

	.faq-list {
		list-style: none;
		margin: var(--space-8) 0 0;
		padding: 0;
	}

	.faq-list details {
		border-bottom: 1px solid var(--border-hairline);
		padding: var(--space-4) 0;
	}

	.faq-list summary {
		cursor: pointer;
		list-style: none;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
	}

	.faq-list summary::-webkit-details-marker {
		display: none;
	}

	.faq-list summary::after {
		content: '';
		flex-shrink: 0;
		width: 0.4rem;
		height: 0.4rem;
		border-style: solid;
		border-color: var(--accent-signature);
		border-width: 0 2px 2px 0;
		transform: rotate(45deg);
		transition: transform 0.2s ease;
	}

	.faq-list details[open] summary::after {
		transform: rotate(225deg);
	}

	.faq-list summary h2 {
		display: inline;
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: 1.05rem;
	}

	.faq-list .answer {
		margin: var(--space-3) 0 0;
		color: var(--text-secondary);
		animation: faq-reveal 0.2s ease;
	}

	@keyframes faq-reveal {
		from {
			opacity: 0;
			transform: translateY(-4px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.back-link {
		display: inline-block;
		margin-bottom: var(--space-6);
		color: var(--text-secondary);
		font-size: var(--type-caption);
	}
</style>

<style>
	.site-header {
		border-bottom: 1px solid var(--border-hairline);
		background: var(--bg-base);
		position: sticky;
		top: 0;
		z-index: 20;
	}

	.site-nav {
		position: relative;
		max-width: var(--max-width);
		margin: 0 auto;
		padding: var(--space-4) var(--space-6);
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1.1rem;
		text-decoration: none;
		color: var(--text-primary);
	}

	.brand-mark {
		display: block;
	}

	.site-nav .nav-links {
		list-style: none;
		display: flex;
