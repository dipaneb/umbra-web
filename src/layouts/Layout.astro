---
import { Font } from 'astro:assets';
import { getLangFromUrl, useTranslations, localizePath, delocalizePath } from '../i18n/utils';
import { languages } from '../i18n/ui';

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
	/** Use `title` verbatim as the full <title> tag, skipping the Home/other-page
	 * wrapping convention below — for the two pages (Download, About) whose
	 * locked SEO title already reads naturally with "Umbra" mid-string rather
	 * than as a " — Umbra" suffix (landing-copy.md §7 Part 1). */
	rawTitle?: boolean;
}

const {
	title = 'Home',
	description = 'Umbra: privacy-first developer tools that don\'t phone home.',
	noindex = false,
	rawTitle = false,
} = Astro.props;

// Step 6.5 — `Astro.currentLocale` works even for static prerendered pages
// (Context7-verified, `/withastro/docs`), but this project detects from the
// URL directly via the shared `getLangFromUrl` helper so Layout, pages, and
// the language switcher all agree on exactly one source of truth.
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Astro always emits the top-level 404 page as a flat `404.html`
// (Context7-verified, /withastro/docs: "This will build to a 404.html
// page"), the one route where the real output ignores this site's
// `trailingSlash: 'always'` directory convention — `Astro.url.pathname`
// itself still reports `/404/`. `/fr/404` isn't host-special-cased, so it
// keeps the normal `index.html`-in-a-directory shape at `/fr/404/`. Caught
// live by lychee (Step 6.11): canonical/hreflang/lang-switch links on both
// 404 pages pointed at `/404/`, a URL that 404s for real.
const isNotFoundPage = Astro.url.pathname === '/404/' || Astro.url.pathname === '/fr/404/';
const canonicalPathname = Astro.url.pathname === '/404/' ? '/404' : Astro.url.pathname;
const canonicalURL = new URL(canonicalPathname, Astro.site);
const isProd = import.meta.env.PROD;
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/fr/';
// Home is the brand — `Umbra — {value}`; every other page is `{value} — Umbra` (landing-copy.md §7).
const pageTitle = rawTitle ? title : isHome ? `Umbra — ${title}` : `${title} — Umbra`;

const isCurrent = (href: string) => Astro.url.pathname === href || Astro.url.pathname === `${href}/`;

// Each locale's own page is self-canonical (never cross-language) — the EN
// and FR versions of a page are different content, not duplicates
// (landing-copy.md §7 Part 6). `hreflang` alternates point at the sibling
// locale's copy of *this same page*, computed generically from the `/fr`
// prefix rather than a per-page lookup table, since no route is
// slug-translated.
const enPath = isNotFoundPage ? '/404' : delocalizePath(Astro.url.pathname);
const frPath = isNotFoundPage ? '/fr/404/' : localizePath(enPath, 'fr');
const enHref = new URL(enPath, Astro.site).toString();
const frHref = new URL(frPath, Astro.site).toString();
const langSwitchHref = lang === 'en' ? frPath : enPath;

// Social share card (Step 6.7, asset produced by Step 5.4) — one universal
// card sitewide, not per-page, per landing-design.md §4's own decision
// (no French variant, no per-tool screenshot swap). The alt text is that
// same section's already-written string, reused verbatim on every page in
// both locales rather than re-derived per page.
const ogImageURL = new URL('/og-image.png', Astro.site).toString();
const ogImageAlt =
	"Umbra wordmark next to the headline \"Local tools. Local AI. Nothing else.\" beside a screenshot of Umbra's JSON tool showing a formatted API-response payload.";
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<!--
			Client-side root redirect (Step 6.5 follow-up) — this site is fully
			static (no adapter, no on-demand rendering), so Astro's own
			`Astro.preferredLocale`/`preferredLocaleList` aren't available here;
			those need a page rendered on demand (Context7-verified,
			/withastro/docs), which this project deliberately isn't. This inline
			script is the cheap alternative: only on the bare English home page,
			only for a visitor who has never used the language switcher, redirect
			once to /fr/ if their browser's first-preference language is French.
			`location.replace` (not a normal navigation) so it doesn't leave an
			English-home entry in browser history. Placed as early as possible in
			<head>, before any other tag, to minimize the flash of English
			content for a French-preferring visitor.
		-->
		{isHome && lang === 'en' && (
			<script is:inline>
				(function () {
					try {
						if (localStorage.getItem('umbra-lang-manual')) return;
						var lang = (navigator.languages && navigator.languages[0]) || navigator.language || '';
						if (/^fr\b/i.test(lang)) location.replace('/fr/');
					} catch (e) {
						// localStorage unavailable (private mode, disabled) — fail open,
						// stay on the default English page rather than error.
					}
				})();
			</script>
		)}
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />

		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		<link rel="alternate" hreflang="en" href={enHref} />
		<link rel="alternate" hreflang="fr" href={frHref} />
		<link rel="alternate" hreflang="x-default" href={enHref} />
		{noindex && <meta name="robots" content="noindex, follow" />}

		<meta property="og:type" content="website" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={ogImageAlt} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />
		<meta name="twitter:image:alt" content={ogImageAlt} />

		<!-- Hubot Sans/Geist Sans are used above the fold on every page (hero
		     or page title, plus body copy); Geist Mono only appears inside
		     occasional inline <code>, so it isn't preloaded. -->
		<Font cssVariable="--font-hubot-sans" preload />
		<Font cssVariable="--font-geist-sans" preload />
		<Font cssVariable="--font-geist-mono" />

		<!--
			PostHog: page-view analytics for this site only (never the Umbra
			app itself — AC3/INV-2). Session recording and autocapture are
			both off, so the only signal collected is "a page was viewed" —
			matching this footer's own disclosure below.

			This is PostHog's Project API Key (public, client-side by design
			— safe to ship in page source, unlike a Personal API Key). EU
			region project, hence the eu.i.posthog.com host below.

			Only loaded on production builds (isProd guard) — local `astro
			dev` sessions and Vercel preview deploys don't pollute
			production page-view counts.
		-->
		{isProd && (
		<script is:inline>
			!(function (t, e) {
				var o, n, p, r;
				e.__SV ||
					((window.posthog = e),
					(e._i = []),
					(e.init = function (i, s, a) {
						function g(t, e) {
							var o = e.split('.');
							2 == o.length && ((t = t[o[0]]), (e = o[1])),
								(t[e] = function () {
									t.push([e].concat(Array.prototype.slice.call(arguments, 0)));
								});
						}
						((p = t.createElement('script')).type = 'text/javascript'),
							(p.crossOrigin = 'anonymous'),
							(p.async = !0),
							(p.src =
								s.api_host.replace('.i.posthog.com', '-assets.i.posthog.com') + '/static/array.js'),
							(r = t.getElementsByTagName('script')[0]).parentNode.insertBefore(p, r);
						var u = e;
						for (
							void 0 !== a ? (u = e[a] = []) : (a = 'posthog'),
								u.people = u.people || [],
								u.toString = function (t) {
									var e = 'posthog';
									return 'posthog' !== a && (e += '.' + a), t || (e += ' (stub)'), e;
								},
								u.people.toString = function () {
									return u.toString(1) + '.people (stub)';
								},
								o =
									'init capture register register_once register_for_session unregister unregister_for_session getFeatureFlag getFeatureFlagPayload isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey getNextSurveyStep identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException loadToolbar get_property getSessionProperty createPersonProfile opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing debug'.split(
										' ',
									),
								n = 0;
							n < o.length;
							n++
						)
							g(u, o[n]);
						e._i.push([i, s, a]);
					}),
					(e.__SV = 1));
			})(document, window.posthog || []);
			posthog.init('phc_qFffTVrdyHuB6yyzY5mSFbjWHAMD2t7M9aid2ySCQ9fL', {
				api_host: 'https://eu.i.posthog.com',
				autocapture: false,
				disable_session_recording: true,
				// Cookieless (Step 6.8 / landing-strategy.md §4): without this,
				// posthog-js defaults to `persistence: 'localStorage+cookie'`,
				// which sets a real persistent cookie — contradicting the "No
				// cookies" claim on /privacy. `cookieless_mode: 'always'` sets no
				// cookie/storage at all; identity is a privacy-preserving hash
				// computed server-side instead. Must also be enabled in the
				// PostHog project's own settings ("Cookieless server hash mode"),
				// or these events are dropped.
				cookieless_mode: 'always',
				// identify()/alias() are unused anywhere on this site (no
				// accounts) and become meaningless under cookieless_mode per
				// PostHog's own guidance — explicitly disabled rather than left
				// silently unreachable.
				person_profiles: 'never',
			});
		</script>
		)}
	</head>
	<body>
		<!-- Skip link (WCAG 2.4.1 Bypass Blocks) — every page repeats the same
		     five-item nav before reaching page content; visually hidden until
		     focused, first element in the tab order. -->
		<a href="#main-content" class="skip-link">{t('a11y.skipToContent')}</a>
		<header class="site-header">
			<nav class="site-nav" aria-label={t('nav.aria')}>
				<a class="brand" href={localizePath('/', lang)}>
					<img class="brand-mark" src="/favicon.svg" width="24" height="24" alt="" />
					Umbra
				</a>
				<!-- Mobile menu toggle — a real <button> (not a checkbox+label
				     hack) so its expanded/collapsed state has proper ARIA
				     semantics and its focus ring is visible; JS below toggles
				     `aria-expanded` and the `.nav-open` class that drives the
				     panel's CSS. -->
				<button
					type="button"
					id="nav-toggle"
					class="nav-toggle-label"
					aria-expanded="false"
					aria-controls="nav-links"
					aria-label={t('nav.menu')}
				>
					<span></span><span></span><span></span>
				</button>
				<ul id="nav-links" class="nav-links">
					<li><a href={localizePath('/tools/', lang)} aria-current={isCurrent(localizePath('/tools', lang)) ? 'page' : undefined}>{t('nav.tools')}</a></li>
					<li><a href={localizePath('/faq/', lang)} aria-current={isCurrent(localizePath('/faq', lang)) ? 'page' : undefined}>{t('nav.faq')}</a></li>
					<li><a href={localizePath('/about/', lang)} aria-current={isCurrent(localizePath('/about', lang)) ? 'page' : undefined}>{t('nav.about')}</a></li>
				</ul>
				<div class="nav-actions">
					<a
						id="nav-download-btn"
						href={localizePath('/download/', lang)}
						class="cta"
						aria-current={isCurrent(localizePath('/download', lang)) ? 'page' : undefined}
						data-analytics="download_clicked"
					>
						{t('nav.download')}
					</a>
					<!-- Language switcher (Step 6.5 / landing-copy.md §5) — labeled with the
					     destination language, never a bare "EN"/"FR" abbreviation, and placed
					     after Download so it doesn't compete with the page's one real CTA.
					     Preserves the exact current page via `langSwitchHref`, never bounces
					     to home. -->
					<a href={langSwitchHref} class="lang-switch" hreflang={lang === 'en' ? 'fr' : 'en'}>
						{languages[lang === 'en' ? 'fr' : 'en']}
					</a>
				</div>
			</nav>
		</header>

		<main id="main-content">
			<slot />
		</main>

		<footer class="site-footer">
			<img class="footer-mark" src="/favicon.svg" width="20" height="20" alt="" loading="lazy" decoding="async" />
			<nav class="footer-links" aria-label={t('footer.aria')}>
				<a href={localizePath('/faq/', lang)}>{t('footer.faq')}</a>
				<a href={localizePath('/privacy/', lang)}>{t('footer.privacy')}</a>
				<a href={localizePath('/legal/', lang)}>{t('footer.legal')}</a>
				<a href={localizePath('/eula/', lang)}>{t('footer.eula')}</a>
				<a href={localizePath('/changelog/', lang)}>{t('footer.changelog')}</a>
				<a href={localizePath('/about/', lang)}>{t('footer.about')}</a>
			</nav>
			<p class="footer-compare">
				{t('footer.compareLabel')} <a href={localizePath('/compare/devtoys/', lang)}>DevToys</a> ·{' '}
				<a href={localizePath('/compare/devutils/', lang)}>DevUtils</a> ·{' '}
				<a href={localizePath('/compare/devtools-x/', lang)}>DevTools-X</a> ·{' '}
				<a href={localizePath('/compare/cyberchef/', lang)}>CyberChef</a>
			</p>
			<!-- TODO(developer): real name — CLAUDE.md's privacy rule blocks committing one here;
			     see landing-copy.md §4 "About" section for the intended wording. -->
			<p>{t('footer.attribution')}</p>
			<p set:html={t('footer.analytics').replace('{privacy}', `<a href="${localizePath('/privacy/', lang)}">${t('footer.analyticsPrivacyLinkText')}</a>`)} />
			<p set:html={t('footer.licence').replace('{eula}', `<a href="${localizePath('/eula/', lang)}">${t('footer.eula')}</a>`)} />
			<p set:html={t('footer.watch').replace('{watchLink}', `<a href="https://github.com/dipaneb/umbra" data-analytics="notify_me_clicked">${t('footer.watchLinkText')}</a>`)} />
			<p>
				<a href={langSwitchHref} class="lang-switch" hreflang={lang === 'en' ? 'fr' : 'en'}>
					{languages[lang === 'en' ? 'fr' : 'en']}
				</a>
			</p>
			<p class="footer-copyright">{t('footer.copyright')}</p>
		</footer>

		<!--
			Delegated analytics click handler (AC3/INV-2 event plan, landing-strategy.md §4).
			Any element with `data-analytics="event_name"` fires that PostHog event on click;
			`data-analytics-props='{"key":"value"}'` is merged in as event properties. Delegated
			at document level so it also covers elements injected by page-level scripts (e.g. the
			download page's live per-platform buttons).
		-->
		<script is:inline>
			function guessPlatform() {
				var ua = navigator.userAgent;
				if (/Mac/.test(ua)) return 'macos';
				if (/Win/.test(ua)) return 'windows';
				if (/Linux/.test(ua)) return 'linux';
				return 'unknown';
			}

			document.addEventListener('click', function (event) {
				var el = event.target.closest('[data-analytics]');
				if (!el || !window.posthog) return;
				var props = {};
				if (el.dataset.analyticsProps) {
					try {
						props = JSON.parse(el.dataset.analyticsProps);
					} catch (e) {
						/* malformed props — send the event without them rather than drop it */
					}
				}
				// Nav/hero/closing-CTA "Download" links go to /download rather than a specific
				// asset, so they don't know which platform yet — best-effort guess from the UA,
				// same purpose ledger row 7's live per-platform logic serves on /download itself.
				if (el.dataset.analytics === 'download_clicked' && !props.platform) {
					props.platform = guessPlatform();
				}
				window.posthog.capture(el.dataset.analytics, props);
			});

			// Marks an explicit language choice (either direction) so the root
			// redirect script above never overrides it — a visitor who
			// deliberately picked a language should never be bounced back by
			// browser-language inference, on this visit or a future one.
			document.addEventListener('click', function (event) {
				if (event.target.closest('.lang-switch')) {
					try {
						localStorage.setItem('umbra-lang-manual', '1');
					} catch (e) {
						// localStorage unavailable — the switch itself still works via
						// normal navigation, only the "don't auto-redirect later" memory is lost.
					}
				}
			});

			// Mobile nav toggle — a real <button> instead of the previous
			// checkbox+label hack, so state is exposed via `aria-expanded`
			// rather than relying on assistive tech to interpret an
			// aria-hidden checkbox. Closes on Escape or on selecting a link,
			// both real keyboard-usability gaps the checkbox version had no
			// way to fix.
			(function () {
				var toggle = document.getElementById('nav-toggle');
				var nav = document.querySelector('.site-nav');
				if (!toggle || !nav) return;
				function setOpen(open) {
					nav.classList.toggle('nav-open', open);
					toggle.setAttribute('aria-expanded', String(open));
				}
				toggle.addEventListener('click', function () {
					setOpen(!nav.classList.contains('nav-open'));
				});
				nav.querySelector('.nav-links').addEventListener('click', function (event) {
					if (event.target.closest('a')) setOpen(false);
				});
				document.addEventListener('keydown', function (event) {
					if (event.key === 'Escape' && nav.classList.contains('nav-open')) {
						setOpen(false);
						toggle.focus();
					}
				});
			})();
		</script>
	</body>
</html>

<style is:global>
	/*
	 * Design tokens (Step 6.2). Colors are DESIGN.md's app palette, carried
	 * over unchanged (landing-design.md §1's own scope was type/spacing/
	 * breakpoints only, not a new color decision) and wired here as
	 * `prefers-color-scheme`-gated custom properties — the mechanism
	 * landing-design.md §6 confirms is the right one for this site (no
	 * Settings surface, so no need for the app's manual [data-theme]
	 * override layer). Type scale, spacing extensions, and radius all come
	 * from landing-design.md §1.
	 *
	 * Breakpoints (landing-design.md §1) are documented here for reference
	 * but used as literal px values in @media rules below — CSS custom
	 * properties cannot appear inside a media query condition:
	 *   --bp-md: 768px · --bp-lg: 1024px · --bp-xl: 1280px
	 */
	:root {
		/* Color — light (DESIGN.md) */
		--bg-base: #f4f5f6;
		--bg-surface: #ffffff;
		--bg-surface-raised: #ffffff;
		--border-hairline: rgba(16, 17, 19, 0.07);
		--text-primary: #18181b;
		--text-secondary: #5b5f66;
		--text-tertiary: #606266;
		--accent-signature: #ff5e1a;
		--accent-signature-on-text: #b64a07;
		--accent-signature-tint: rgba(255, 94, 26, 0.12);
		--accent-default: #18181b;
		--accent-default-on: #ffffff;
		--accent-destructive: #cf3130;
		--accent-neutral-chip: #e4e5e7;

		/* Shape */
		--radius-sm: 0.125rem; /* 2px */
		--radius-default: 0.25rem; /* 4px */
		--radius-lg: 0.5rem; /* 8px */
		--radius-full: 9999px;

		/* Spacing — DESIGN.md's 4px unit, extended upward for page rhythm */
		--space-1: 0.25rem; /* 4px */
		--space-2: 0.5rem; /* 8px */
		--space-3: 0.75rem; /* 12px */
		--space-4: 1rem; /* 16px */
		--space-5: 1.25rem; /* 20px */
		--space-6: 1.5rem; /* 24px */
		--space-8: 2rem; /* 32px */
		--space-10: 2.5rem; /* 40px */
		--space-12: 3rem; /* 48px */
		--space-16: 4rem; /* 64px */
		--space-20: 5rem; /* 80px */
		--space-24: 6rem; /* 96px */
		--space-32: 8rem; /* 128px */
		--space-section: clamp(3rem, 1.944rem + 4.507vw, 6rem);
		--space-section-lg: clamp(4rem, 2.592rem + 6.009vw, 8rem);

		/* Type — families (self-hosted via Astro's Fonts API, see <Font> tags) */
		--font-sans: var(--font-geist-sans), system-ui, sans-serif;
		--font-mono: var(--font-geist-mono), ui-monospace, monospace;
		--font-display: var(--font-hubot-sans), var(--font-geist-sans), sans-serif;

		/* Type — fluid scale, 375px→1440px reference viewport (landing-design.md §1) */
		--type-hero: clamp(2.25rem, 1.634rem + 2.629vw, 4rem);
		--type-h1: clamp(1.875rem, 1.567rem + 1.315vw, 2.75rem);
		--type-h2: clamp(1.375rem, 1.155rem + 0.939vw, 2rem);
		--type-h3: clamp(1.125rem, 1.037rem + 0.376vw, 1.375rem);
		--type-body-lead: clamp(1.125rem, 1.037rem + 0.376vw, 1.375rem);
		--type-body: clamp(1rem, 0.956rem + 0.188vw, 1.125rem);
		--type-label: 0.8125rem;
		--type-caption: 0.75rem;
		--type-code: 0.875rem;

		--max-width: 72rem;
	}

	@media (prefers-color-scheme: dark) {
		:root {
			--bg-base: #141415;
			--bg-surface: #1d1d1f;
			--bg-surface-raised: #28282b;
			--border-hairline: rgba(255, 255, 255, 0.07);
			--text-primary: #ededed;
			--text-secondary: #9a9da3;
			--text-tertiary: #a6a8ab;
			--accent-signature: #ff6e30;
			/* Already clears AA as text in dark mode — no separate on-text
			   value needed (DESIGN.md), so this just tracks the signature. */
			--accent-signature-on-text: #ff6e30;
			--accent-signature-tint: rgba(255, 110, 48, 0.16);
			--accent-default: #ededed;
			--accent-default-on: #141415;
			--accent-destructive: #f2665c;
			--accent-neutral-chip: #2c2c2f;
		}
	}

	/*
	 * `<html>` must keep its font-size at the browser default (100%) — every
	 * type size above is authored in rem specifically so it honors a
	 * visitor's browser text-size preference (WCAG 1.4.4). Do not add an
	 * `html { font-size: ... }` override (landing-design.md §1's guardrail).
	 */
	* {
		box-sizing: border-box;
	}

	/* The download page toggles the `hidden` attribute via JS on elements
	   (like .button) that set their own `display` — without this, that
	   class's display value wins the cascade over the UA's [hidden] rule. */
	[hidden] {
		display: none !important;
	}

	html,
	body {
		margin: 0;
		padding: 0;
	}

	body {
		font-family: var(--font-sans);
		font-size: var(--type-body);
		font-weight: 400;
		line-height: 1.6;
		color: var(--text-primary);
		background: var(--bg-base);
	}

	main {
		display: block;
	}

	h1,
	h2,
	h3 {
		font-family: var(--font-display);
		font-weight: 700;
		margin: 0;
	}

	h1 {
		font-size: var(--type-h1);
		line-height: 1.15;
		letter-spacing: -0.01em;
	}

	h2 {
		font-size: var(--type-h2);
		line-height: 1.25;
		letter-spacing: -0.01em;
	}

	h3 {
		font-family: var(--font-sans);
		font-size: var(--type-h3);
		font-weight: 600;
		line-height: 1.3;
	}

	code,
	pre {
		font-family: var(--font-mono);
		font-size: var(--type-code);
	}

	a {
		color: var(--accent-signature-on-text);
	}

	a:focus-visible,
	button:focus-visible,
	input:focus-visible,
	summary:focus-visible,
	[tabindex]:focus-visible {
		outline: 3px solid var(--accent-signature);
		outline-offset: 2px;
	}

	/* A handful of controls (nav toggle's old checkbox, the Download page's
	   OS radios) are visually-hidden inputs styled entirely via their
	   sibling <label> — `opacity: 0` on the input itself also hides its
	   native focus ring, so the visible label needs to carry it instead
	   when the hidden input is the one that's actually focused. */
	input:focus-visible + label {
		outline: 3px solid var(--accent-signature);
		outline-offset: 2px;
	}

	/* Skip link (WCAG 2.4.1) — visually hidden until it receives keyboard
	   focus, then pinned to the top-left corner above everything else. */
	.skip-link {
		position: absolute;
		top: -3rem;
		left: var(--space-4);
		z-index: 100;
		background: var(--accent-signature);
		color: #ffffff;
		padding: var(--space-2) var(--space-4);
		border-radius: var(--radius-default);
		text-decoration: none;
		font-weight: 600;
		transition: top 0.15s ease;
	}

	.skip-link:focus {
		top: var(--space-4);
	}

	/* Shared page-building blocks (Step 6.3) — kept here rather than
	   redeclared per page, since every page in the Phase 2 inventory reuses
	   the same container/section/button/prose/card-grid shapes. */
	.container {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 0 var(--space-6);
	}

	.section {
		padding: var(--space-section) 0;
	}

	.section > h1,
	.section > h2 {
		text-align: center;
	}

	.section-lede {
		max-width: 40rem;
		margin: var(--space-3) auto 0;
		color: var(--text-secondary);
		text-align: center;
	}

	.button {
		display: inline-block;
		background: var(--accent-signature);
		color: #ffffff;
		text-decoration: none;
		font-weight: 600;
		padding: 0.75rem 1.5rem;
		border-radius: var(--radius-default);
		border: none;
		font-size: var(--type-body);
		font-family: var(--font-sans);
		cursor: pointer;
	}

	.button:hover {
		opacity: 0.9;
		color: #ffffff;
	}

	.button-secondary {
		display: inline-block;
		background: transparent;
		color: var(--text-primary);
		text-decoration: none;
		font-weight: 600;
		padding: 0.75rem 1.5rem;
		border-radius: var(--radius-default);
		border: 1px solid var(--border-hairline);
	}

	.button-secondary:hover {
		border-color: var(--accent-signature);
		color: var(--accent-signature-on-text);
	}

	.prose h1 {
		font-size: var(--type-h1);
		margin-bottom: var(--space-2);
	}

	.prose .page-lede {
		color: var(--text-secondary);
		font-size: var(--type-body-lead);
		margin: 0 0 var(--space-10);
	}

	.prose h2 {
		font-size: var(--type-h3);
		margin: var(--space-10) 0 var(--space-3);
	}

	.prose p,
	.prose ul,
	.prose ol {
		margin: 0 0 var(--space-4);
		color: var(--text-secondary);
	}

	.prose strong {
		color: var(--text-primary);
	}

	.prose a {
		text-decoration: underline;
	}

	/* .prose a's underline is for inline body links only — it must not
	   bleed onto button-styled anchors (e.g. a tool/compare page's Download
	   CTA, which lives inside a .prose container). */
	.prose a.button,
	.prose a.button-secondary,
	.prose a.card-link {
		text-decoration: none;
	}

	.prose code {
		background: var(--bg-surface);
		border: 1px solid var(--border-hairline);
		border-radius: var(--radius-sm);
		padding: 0.1rem 0.35rem;
	}

	.card-grid {
		list-style: none;
		margin: var(--space-10) 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
		gap: var(--space-5);
	}

	.card {
		border: 1px solid var(--border-hairline);
		border-radius: var(--radius-lg);
		padding: var(--space-5);
		background: var(--bg-surface);
		transition: transform 0.15s ease;
	}

	.card:hover {
		transform: translateY(-2px);
	}

	.card h3 {
		margin: 0 0 var(--space-2);
		font-size: 1.05rem;
	}

	.card p {
		margin: 0;
		color: var(--text-secondary);
		font-size: 0.92rem;
	}

	.card a.card-link {
		text-decoration: none;
		color: inherit;
		display: block;
	}

	.card a.card-link:hover h3 {
		color: var(--accent-signature-on-text);
	}

	.compare-table {
		width: 100%;
		border-collapse: collapse;
		margin: var(--space-6) 0;
		font-size: var(--type-body);
	}

	.compare-table caption {
		text-align: left;
		color: var(--text-secondary);
		margin-bottom: var(--space-3);
	}

	.compare-table th,
	.compare-table td {
		border: 1px solid var(--border-hairline);
		padding: var(--space-3) var(--space-4);
		text-align: left;
		vertical-align: top;
	}

	.compare-table thead th {
		background: var(--bg-surface);
	}

	.faq-list {
		list-style: none;
		margin: var(--space-8) 0 0;
		padding: 0;
	}

	.faq-list details {
		border-bottom: 1px solid var(--border-hairline);
		padding: var(--space-4) 0;
	}

	.faq-list summary {
		cursor: pointer;
		list-style: none;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
	}

	.faq-list summary::-webkit-details-marker {
		display: none;
	}

	.faq-list summary::after {
		content: '';
		flex-shrink: 0;
		width: 0.4rem;
		height: 0.4rem;
		border-style: solid;
		border-color: var(--accent-signature);
		border-width: 0 2px 2px 0;
		transform: rotate(45deg);
		transition: transform 0.2s ease;
	}

	.faq-list details[open] summary::after {
		transform: rotate(225deg);
	}

	.faq-list summary h2 {
		display: inline;
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: 1.05rem;
	}

	.faq-list .answer {
		margin: var(--space-3) 0 0;
		color: var(--text-secondary);
		animation: faq-reveal 0.2s ease;
	}

	@keyframes faq-reveal {
		from {
			opacity: 0;
			transform: translateY(-4px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.back-link {
		display: inline-block;
		margin-bottom: var(--space-6);
		color: var(--text-secondary);
		font-size: var(--type-caption);
	}
</style>

<style>
	.site-header {
		border-bottom: 1px solid var(--border-hairline);
		background: var(--bg-base);
		position: sticky;
		top: 0;
		z-index: 20;
	}

	.site-nav {
		position: relative;
		max-width: var(--max-width);
		margin: 0 auto;
		padding: var(--space-4) var(--space-6);
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1.1rem;
		text-decoration: none;
		color: var(--text-primary);
	}

	.brand-mark {
		display: block;
	}

	.site-nav .nav-links {
		list-style: none;
		display: flex;
		gap: var(--space-6);
		margin: 0;
		padding: 0;
		align-items: center;
	}

	.site-nav a {
		text-decoration: none;
		color: var(--text-primary);
	}

	.site-nav a:hover {
		color: var(--accent-signature-on-text);
	}

	.site-nav a.cta {
		background: var(--accent-signature);
		color: #ffffff;
		padding: var(--space-2) var(--space-4);
		border-radius: var(--radius-default);
		transition: opacity 0.2s ease;
	}

	.site-nav a.cta:hover {
		color: #ffffff;
		opacity: 0.9;
	}

	.nav-actions {
		display: flex;
		align-items: center;
		gap: var(--space-4);
	}

	/* Language switcher — after Download, low visual weight on purpose
	   (landing-copy.md §5: a utility control, not a second CTA). */
	.lang-switch {
		font-size: var(--type-caption);
		color: var(--text-secondary);
		text-decoration: none;
	}

	.lang-switch:hover {
		color: var(--text-primary);
	}

	/* Mobile nav — a JS-toggled collapsible panel (landing-design.md §2's
	   "wordmark + Download + hamburger" mobile treatment). The hamburger's
	   expanded state wasn't drawn in that mockup; this is a plain dropdown
	   panel with the same links, not a re-decided design. `#nav-toggle` is a
	   real <button> (Step 6.9) — reset its browser-default appearance so it
	   still looks like a bare hamburger icon. */
	.nav-toggle-label {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 4px;
		width: 32px;
		height: 32px;
		padding: 0;
		border: none;
		background: none;
		cursor: pointer;
	}

	.nav-toggle-label span {
		display: block;
		height: 2px;
		background: var(--text-primary);
		border-radius: 1px;
	}

	@media (max-width: 767px) {
		.nav-toggle-label {
			display: flex;
		}

		.site-nav .nav-links {
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			flex-direction: column;
			align-items: flex-start;
			gap: 0;
			background: var(--bg-base);
			border-bottom: 1px solid var(--border-hairline);
			max-height: 0;
			overflow: hidden;
			/* `visibility` is delayed on the way in and instant on the way
			   out — collapsed links must leave the tab order the instant
			   the panel closes (Step 6.9: they were previously still
			   keyboard-focusable at max-height: 0, an invisible focus trap
			   for keyboard users tabbing through a closed menu). */
			visibility: hidden;
			transition: max-height 0.2s ease, visibility 0s linear 0.2s;
		}

		.site-nav .nav-links li {
			width: 100%;
		}

		.site-nav .nav-links a {
			display: block;
			padding: var(--space-4) var(--space-6);
			width: 100%;
			box-sizing: border-box;
		}

		.site-nav.nav-open .nav-links {
			max-height: 16rem;
			visibility: visible;
			transition: max-height 0.2s ease;
		}
	}

	.site-footer {
		max-width: var(--max-width);
		margin: var(--space-12) auto 0;
		padding: var(--space-6) var(--space-6) var(--space-12);
		border-top: 1px solid var(--border-hairline);
		color: var(--text-secondary);
		font-size: var(--type-caption);
	}

	.footer-mark {
		display: block;
		margin-bottom: var(--space-3);
	}

	.footer-links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-4);
		margin-bottom: var(--space-3);
	}

	.footer-links a {
		color: var(--text-secondary);
	}

	.footer-links a:hover {
		color: var(--accent-signature-on-text);
	}

	.footer-compare {
		font-size: var(--type-caption);
	}

	.site-footer p {
		margin: 0.4rem 0;
	}

	.footer-copyright {
		margin-top: var(--space-6);
	}
</style>
