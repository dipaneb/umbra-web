---
import ToolPage from '../../components/ToolPage.astro';

const faqs = [
	{
		q: 'Why not use a free online cron generator?',
		a: "A cron expression alone reveals nothing sensitive, so the privacy case is weaker here than elsewhere in Umbra — but it's still one tool fewer to leave the app for (the same standard 5-field syntax crontab uses).",
	},
	{
		q: 'Does it understand phrases like "every day at 5pm"?',
		a: "No, deliberately — Umbra used to parse free-text phrases into cron expressions; that parser was retired for a guided grid that can't be phrased wrong. Paste an existing expression instead and Cron reads it back in plain language.",
	},
];
---

<ToolPage
	title="Cron Expression Builder — Offline"
	description="Build a standard 5-field cron expression with a guided grid, or paste one to see it explained in plain language."
	name="Cron"
	directAnswer="Umbra's Cron tool builds a standard 5-field cron expression field by field, or reads one back when you paste it in — entirely offline."
	body="Set the minute, hour, day-of-month, month, and day-of-week fields individually with a guided grid, or paste an existing expression to see it explained in plain language and previewed against its next three run times. There's no free-text guessing on either side — every field is picked from a fixed set of valid values."
	screenshotSlug="cron"
	screenshotAlt="Umbra's Cron tool showing a guided 5-field schedule, its plain-language description, and its next three run times."
	faqs={faqs}
/>
