---
import Layout from '../layouts/Layout.astro';

const tools = [
	{
		icon: '{ }',
		name: 'JSON',
		blurb: 'Format, minify, and validate JSON — then browse it as a collapsible tree, even at 10MB.',
	},
	{
		icon: '64',
		name: 'Base64',
		blurb: 'Encode and decode text or whole files to and from Base64, locally.',
	},
	{
		icon: 'ID',
		name: 'UUID',
		blurb: 'Generate UUIDs on demand, no network round-trip required.',
	},
	{
		icon: '#',
		name: 'Hash',
		blurb: 'Hash text or files (SHA-256, SHA-512, SHA-1, MD5) and get a checksum instantly.',
	},
	{
		icon: 'JWT',
		name: 'JWT',
		blurb: 'Decode a JWT and read its header and payload — offline, so the token never leaves your machine.',
	},
	{
		icon: 'CRN',
		name: 'Cron',
		blurb: 'Translate a cron expression into plain English, or type a schedule and get the expression back.',
	},
	{
		icon: 'OCR',
		name: 'Bucket',
		blurb: 'Drop in an image or paste a screenshot, get its text back out, via on-device OCR.',
	},
];
---

<Layout
	title="Privacy-first developer tools"
	description="Umbra is a desktop app bundling everyday developer tools — JSON, Base64, UUID, hashing, JWT, cron, and OCR — with one disclosed network exception: the update check."
>
	<section class="hero">
		<h1>Developer tools that don't phone home.</h1>
		<p class="lede">
			Umbra bundles the small tools you reach for constantly — JSON formatting, Base64, hashing,
			JWT decoding, cron, and more — into one desktop app that makes zero network calls except
			one, explicitly disclosed: the automatic check for app updates. Installing an update always
			requires your explicit confirmation first — nothing installs silently. There is no telemetry
			anywhere in the app.
		</p>
		<a class="button" href="/download">Download for Mac (Apple Silicon)</a>
	</section>

	<section class="tools" aria-labelledby="tools-heading">
		<h2 id="tools-heading">Seven tools, one app</h2>
		<ul class="tool-grid">
			{
				tools.map((tool) => (
					<li class="tool-card">
						<span class="tool-icon" aria-hidden="true">
							{tool.icon}
						</span>
						<h3>{tool.name}</h3>
						<p>{tool.blurb}</p>
					</li>
				))
			}
		</ul>
	</section>

	<section class="cta-band">
		<h2>See the privacy promise for yourself</h2>
		<p>
			Read exactly what Umbra sends over the network, and how that's verified before every
			release, on the <a href="/faq">FAQ</a>.
		</p>
		<a class="button" href="/download">Download for Mac (Apple Silicon)</a>
	</section>
</Layout>

<style>
	.hero {
		max-width: 46rem;
		margin: 0 auto;
		padding: 4rem 1.5rem 3rem;
		text-align: center;
	}

	.hero h1 {
		font-size: 2.5rem;
		margin: 0 0 1rem;
	}

	.lede {
		font-size: 1.1rem;
		color: var(--color-text-muted);
		margin: 0 0 2rem;
	}

	.button {
		display: inline-block;
		background: var(--color-accent);
		color: var(--color-accent-contrast);
		text-decoration: none;
		font-weight: 600;
		padding: 0.75rem 1.5rem;
		border-radius: 0.4rem;
	}

	.button:hover {
		opacity: 0.9;
		color: var(--color-accent-contrast);
	}

	.tools {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 1rem 1.5rem 4rem;
	}

	.tools h2 {
		text-align: center;
		margin-bottom: 2rem;
	}

	.tool-grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
		gap: 1.25rem;
	}

	.tool-card {
		border: 1px solid var(--color-border);
		border-radius: 0.6rem;
		padding: 1.25rem;
		background: var(--color-bg-subtle);
	}

	.tool-icon {
		display: inline-block;
		font-family: ui-monospace, monospace;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.03em;
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: 0.3rem;
		padding: 0.2rem 0.5rem;
		margin-bottom: 0.75rem;
	}

	.tool-card h3 {
		margin: 0 0 0.4rem;
		font-size: 1.05rem;
	}

	.tool-card p {
		margin: 0;
		color: var(--color-text-muted);
		font-size: 0.92rem;
	}

	.cta-band {
		max-width: 36rem;
		margin: 0 auto;
		padding: 2rem 1.5rem 4rem;
		text-align: center;
	}

	.cta-band p {
		color: var(--color-text-muted);
		margin: 0.75rem 0 1.5rem;
	}
</style>
