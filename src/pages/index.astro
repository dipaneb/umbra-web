---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

// Single source for every tool's name/description/search-terms text (the
// content-collection refactor, landing-ia.md §5) — both this bento grid and
// the mobile horizontal-scroll strip below read it, keyed by id. The bento's
// hand-tuned visual layout (grid areas, icons, ghost glyphs, tile sizing)
// stays presentation code here, not data, since it's a one-off marketing
// design rather than something that repeats and could drift.
const tools = await getCollection('tools');
const byId = Object.fromEntries(tools.map((tool) => [tool.id, tool.data]));

// Mobile horizontal-scroll strip only — text-shorthand badges are the
// confirmed placeholder for that tier (landing-design.md §2); desktop/tablet
// use the bento grid below, with real line icons.
const mobileTools = tools.sort((a, b) => a.data.order - b.data.order);
---

<Layout
	title="Local, Offline Developer Tools"
	description="JSON, JWT, hashing, cron, and more — everyday developer tools that run entirely on your machine. Free, no account, no cloud."
>
	<section class="hero" id="hero">
		<div class="hero-text">
			<h1>Local tools. Local AI.<br />Nothing else.</h1>
			<p class="lede">The tools you reach for every day,<br />all bundled in one app,<br />fully offline.</p>
			<a class="button" href="/download/" data-analytics="download_clicked">Download</a>
		</div>
		<div class="hero-media container">
			<video
				class="hero-video"
				controls
				muted
				preload="none"
				poster="/videos/workflow-demo.en.poster.jpg"
				width="960"
				height="540"
				aria-label="Umbra demo: pressing ⌘K, formatting JSON, decoding a JWT, and building a cron schedule"
			>
				<source src="/videos/workflow-demo.en.webm" type="video/webm" />
				<source src="/videos/workflow-demo.en.mp4" type="video/mp4" />
			</video>
		</div>
	</section>

	<section class="section tools container" aria-labelledby="tools-heading">
		<h2 id="tools-heading">9 tools</h2>

		<!-- Bento grid — desktop (4-col) and tablet (3-col reflow), landing-design.md §2.
		     The search bar lives inside the palette tile itself, not as a separate
		     element above the grid — one command-palette-styled box, not two. -->
		<div class="bento-grid">
			<a class="tile on-light tile-json" data-tool-name={byId.json.searchTerms} href="/tools/json/">
				<span class="ghost">{'{ }'}</span>
				<div class="tile-content">
					<h3 class="tile-name">{byId.json.name}</h3>
					<p class="tile-desc">{byId.json.tileDescription}</p>
				</div>
			</a>

			<div class="tile on-default tile-palette">
				<input id="tool-search" class="palette-input" type="text" placeholder="⌘K" aria-label="Search tools" />
				<h3 class="tile-name tile-name-display">Type it.<br />Find any tool.</h3>
			</div>

			<a class="tile on-accent tile-hash" data-tool-name={byId.hash.searchTerms} href="/tools/hash/">
				<span class="ghost ghost-on-accent">#</span>
				<div class="tile-content">
					<h3 class="tile-name">{byId.hash.name}</h3>
					<p class="tile-desc">{byId.hash.tileDescription}</p>
				</div>
			</a>

			<a class="tile on-light tile-uuid tile-square" data-tool-name={byId.uuid.searchTerms} href="/tools/uuid/">
				<svg class="icon" viewBox="0 0 24 24" stroke="currentColor"><rect x="3" y="5" width="18" height="14" rx="2"></rect><circle cx="8" cy="12" r="2"></circle><line x1="13" y1="9" x2="18" y2="9"></line><line x1="13" y1="15" x2="16" y2="15"></line></svg>
				<h3 class="tile-name tile-name-sm">{byId.uuid.name}</h3>
			</a>

			<a class="tile on-light tile-jwt tile-square" data-tool-name={byId.jwt.searchTerms} href="/tools/jwt/">
				<svg class="icon" viewBox="0 0 24 24" stroke="currentColor"><circle cx="8" cy="12" r="4"></circle><line x1="12" y1="12" x2="21" y2="12"></line><line x1="17" y1="12" x2="17" y2="16"></line><line x1="21" y1="12" x2="21" y2="16"></line></svg>
				<h3 class="tile-name tile-name-sm">{byId.jwt.name}</h3>
			</a>

			<a class="tile on-light tile-base64" data-tool-name={byId.base64.searchTerms} href="/tools/base64/">
				<svg class="icon" viewBox="0 0 24 24" stroke="currentColor"><path d="M3 8h13l-3.5-3.5M3 8l3.5 3.5M21 16H8l3.5-3.5M21 16l-3.5 3.5"></path></svg>
				<h3 class="tile-name">{byId.base64.name}</h3>
				<p class="tile-desc">{byId.base64.tileDescription}</p>
			</a>

			<a class="tile on-light tile-cron" data-tool-name={byId.cron.searchTerms} href="/tools/cron/">
				<svg class="icon" viewBox="0 0 24 24" stroke="currentColor"><circle cx="12" cy="12" r="8.5"></circle><line x1="12" y1="12" x2="12" y2="7"></line><line x1="12" y1="12" x2="15.5" y2="14"></line></svg>
				<h3 class="tile-name">{byId.cron.name}</h3>
				<p class="tile-desc">{byId.cron.tileDescription}</p>
			</a>

			<a class="tile on-light tile-ocr" data-tool-name={byId.ocr.searchTerms} href="/tools/ocr/">
				<svg class="icon" viewBox="0 0 24 24" stroke="currentColor"><path d="M4 8V5a1 1 0 0 1 1-1h3M20 8V5a1 1 0 0 0-1-1h-3M4 16v3a1 1 0 0 0 1 1h3M20 16v3a1 1 0 0 1-1 1h-3"></path><line x1="8" y1="10" x2="16" y2="10"></line><line x1="8" y1="14" x2="14" y2="14"></line></svg>
				<h3 class="tile-name">{byId.ocr.name}</h3>
				<p class="tile-desc">{byId.ocr.tileDescription}</p>
			</a>

			<a class="tile on-light tile-pdf" data-tool-name={byId.pdf.searchTerms} href="/tools/pdf/">
				<svg class="icon" viewBox="0 0 24 24" stroke="currentColor"><path d="M6 3h9l4 4v14a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z"></path><path d="M15 3v4h4"></path><line x1="8" y1="13" x2="16" y2="13"></line><line x1="8" y1="16.5" x2="16" y2="16.5"></line></svg>
				<h3 class="tile-name">{byId.pdf.name}</h3>
				<p class="tile-desc">{byId.pdf.tileDescription}</p>
			</a>

			<a
				class="tile on-light tile-images"
				data-tool-name={byId.image.searchTerms}
				href="/tools/image/"
			>
				<svg class="icon icon-lg" viewBox="0 0 24 24" stroke="currentColor"><rect x="3" y="4" width="18" height="16" rx="2"></rect><circle cx="8.5" cy="9.5" r="1.75"></circle><path d="M21 16l-5.5-5.5a1 1 0 0 0-1.4 0L6 19"></path></svg>
				<div class="tile-images-text"><h3 class="tile-name">{byId.image.name}</h3><p class="tile-desc">{byId.image.tileDescription}</p></div>
				<div class="tile-images-tags">
					<span class="tag tag-neutral">PNG</span><span class="tag tag-neutral">JPEG</span><span class="tag tag-neutral">WebP</span><span class="tag tag-neutral">AVIF</span>
				</div>
			</a>
		</div>

		<!-- Mobile horizontal-scroll strip — landing-design.md §2, confirmed unchanged for <768px -->
		<ul class="mobile-strip">
			{
				mobileTools.map((tool) => (
					<li class="mobile-strip-card" data-tool-name={tool.data.searchTerms}>
						<a class="card-link" href={`/tools/${tool.id}/`}>
							<span class="tool-icon" aria-hidden="true">
								{tool.data.icon}
							</span>
							<h3>{tool.data.name}</h3>
						</a>
					</li>
				))
			}
		</ul>
	</section>

	<section class="section section-alt workflow container" aria-labelledby="workflow-heading">
		<div class="workflow-copy">
			<h2 id="workflow-heading">Every tool, one search away</h2>
			<p class="section-lede">
				Press ⌘K from anywhere in Umbra. Format a JSON payload, decode a JWT, build a cron schedule —
				the same shortcut, every time, without breaking flow to open a new tool.
			</p>
		</div>
		<video
			class="workflow-video"
			controls
			muted
			preload="none"
			poster="/videos/workflow-demo.en.poster.jpg"
			width="960"
			height="540"
			aria-label="Umbra demo: pressing ⌘K, formatting JSON, decoding a JWT, and building a cron schedule"
		>
			<source src="/videos/workflow-demo.en.webm" type="video/webm" />
			<source src="/videos/workflow-demo.en.mp4" type="video/mp4" />
		</video>
	</section>

	<section class="section proof container" aria-labelledby="proof-heading">
		<h2 id="proof-heading">Verify it yourself</h2>
		<p class="proof-lead">
			<strong
				>There's no server for your data to go to — with one disclosed exception, an automatic
				check for app updates.</strong
			> Umbra is a native app, not a client talking to a backend. What you paste, drop, or type is
			processed on the machine in front of you, by code running on that machine — there's nothing to
			intercept, because there's nowhere for it to go, except for that one exception: once, at
			launch, Umbra checks GitHub for a newer release, the single network call it ever makes, and
			nothing installs without you confirming it first.
		</p>

		<div class="diagram" role="img" aria-label="Your machine, with no connection to any server">
			<span class="diagram-box">Your machine</span>
			<span class="diagram-x" aria-hidden="true">✕</span>
			<span class="diagram-box diagram-box-muted">Server</span>
		</div>

		<p>
			It's built this way structurally, not by policy: a native Rust application, compiled to a
			single binary, with no client-server architecture underneath it for anything to route through
			in the first place.
		</p>

		<p>
			The source is public — <a href="https://github.com/dipaneb/umbra">read it yourself</a>. Umbra's
			repository is source-available: open the networking layer and confirm this isn't just
			asserted. (Source-available isn't open source — you can view the code, not redistribute or
			reuse it. More on that <a href="/faq/#open-source-and-audit-status">in the FAQ</a>.)
		</p>

		<p>
			The macOS build is signed with a Developer ID certificate and notarized by Apple, so it opens
			with no Gatekeeper warning on a clean install.
		</p>

		<!-- Self-check terminal — hidden on mobile: a phone can't run this or install the
		     binary it's checking (landing-design.md §2, confirmed 2026-09-22). -->
		<div class="proof-selfcheck">
			<p class="proof-checkline"><strong>Don't take our word for it.</strong> Quit and relaunch Umbra while this is running, on your own downloaded
				copy:</p>
			<pre class="proof-command"><code>nettop -p $(pgrep -x umbra)</code></pre>
			<p>
				You'll see one connection — the update check, at launch — and nothing else, no matter which
				tool you use. (macOS only. Windows and Linux instructions aren't written yet.)
			</p>
		</div>
	</section>

	<section class="section section-alt why container" aria-labelledby="why-heading">
		<h2 id="why-heading">Why Umbra</h2>
		<ul class="why-grid">
			<li>
				<strong>Instant.</strong> A native Rust app, not a browser tab — cold launch measured under 2
				seconds, and kept there as new tools are added.
			</li>
			<li>
				<strong>However you work.</strong> Full keyboard navigation and screen-reader-labeled
				controls, in every tool.
			</li>
			<li>
				<strong>Always your call.</strong> Every update is a confirmation, not a background install.
				Nothing changes without you saying so.
			</li>
			<li>
				<strong>No strings attached.</strong> Download and use it — no sign-up, no trial clock, no
				plan to pick.
			</li>
		</ul>
	</section>

	<section class="section closing-cta container">
		<a class="button" href="/download/" data-analytics="download_clicked">Download</a>
		<p class="availability">Available for macOS, Windows, and Linux.</p>
	</section>
</Layout>

<script is:inline>
	(function () {
		// Live-filtering search — dims/greys non-matching tiles and outlines
		// matches in the signature accent, across the bento grid (desktop/
		// tablet) and the mobile strip alike (landing-design.md §2).
		var input = document.getElementById('tool-search');
		var tiles = Array.prototype.slice.call(document.querySelectorAll('[data-tool-name]'));
		if (input) {
			input.addEventListener('input', function () {
				var q = input.value.trim().toLowerCase();
				tiles.forEach(function (tile) {
					var hay = (tile.getAttribute('data-tool-name') || '').toLowerCase();
					var match = q === '' || (hay !== '' && hay.indexOf(q) !== -1);
					tile.style.opacity = match ? '1' : '0.3';
					tile.style.filter = match ? 'none' : 'grayscale(70%)';
					tile.style.outline = match && q !== '' && hay !== '' ? '2px solid var(--accent-signature)' : 'none';
					tile.style.outlineOffset = '2px';
				});
			});
		}

		// Nav Download button hides while the hero (which carries its own,
		// more prominent CTA) is in view, per landing-design.md §2.
		var hero = document.getElementById('hero');
		var navBtn = document.getElementById('nav-download-btn');
		if (hero && navBtn) {
			var observer = new IntersectionObserver(
				function (entries) {
					entries.forEach(function (entry) {
						navBtn.style.opacity = entry.isIntersecting ? '0' : '1';
						navBtn.style.pointerEvents = entry.isIntersecting ? 'none' : 'auto';
					});
				},
				{ threshold: 0.2 },
			);
			observer.observe(hero);
		}
	})();
</script>

<style>
	.hero {
		padding: var(--space-section-lg) var(--space-6);
		text-align: center;
	}

	.hero-text {
		max-width: 46rem;
		margin: 0 auto;
	}

	.hero h1 {
		font-family: var(--font-display);
		font-size: var(--type-hero);
		line-height: 1.05;
		letter-spacing: -0.02em;
		margin: 0 0 var(--space-4);
	}

	.lede {
		font-size: var(--type-body-lead);
		color: var(--text-secondary);
		margin: 0 0 var(--space-8);
	}

	.hero-media {
		margin-top: var(--space-10);
	}

	.hero-video {
		display: block;
		width: 100%;
		border-radius: var(--radius-lg);
		border: 1px solid var(--border-hairline);
	}

	.section-alt {
		background: var(--bg-surface);
		border-top: 1px solid var(--border-hairline);
		border-bottom: 1px solid var(--border-hairline);
	}

	/* Bento grid — asymmetric, tight gaps, semantic-role tiles so dark mode
	   inverts correctly (landing-design.md §2/§6). Desktop: 4 columns. */
	.bento-grid {
		margin-top: var(--space-8);
		display: grid;
		gap: 12px;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		grid-template-areas:
			'json    palette palette hash'
			'json    uuid    jwt     hash'
			'base64  cron    ocr     pdf'
			'images  images  images  images';
	}

	.tile {
		border-radius: 6px;
		box-sizing: border-box;
		position: relative;
		overflow: hidden;
		display: block;
		text-decoration: none;
		transition: transform 0.15s ease, opacity 0.15s ease, filter 0.15s ease, outline-color 0.15s ease;
	}

	a.tile:hover {
		transform: translateY(-2px);
	}

	.on-light {
		background: var(--bg-surface);
		border: 1px solid var(--border-hairline);
	}

	.on-default {
		background: var(--accent-default);
		color: var(--accent-default-on);
	}

	.on-accent {
		background: var(--accent-signature);
		color: #ffffff;
	}

	.ghost {
		position: absolute;
		top: -0.75rem;
		left: 0.25rem;
		font-family: var(--font-mono);
		font-weight: 700;
		line-height: 1;
		font-size: 8rem;
		color: color-mix(in srgb, var(--text-primary) 6%, transparent);
		pointer-events: none;
	}

	.ghost-on-accent {
		left: auto;
		right: -0.5rem;
		top: -1.25rem;
		font-size: 9rem;
		color: rgba(255, 255, 255, 0.14);
	}

	.tile-content {
		position: relative;
		z-index: 1;
	}

	.tile-name {
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: 1.05rem;
		margin: 0;
		color: var(--text-primary);
	}

	/* Tiles are <a> elements — override the global link color so tile names
	   read as titles, not as underlined-blue-style links. */
	.on-accent .tile-name,
	.on-default .tile-name {
		color: inherit;
	}

	.tile-name-sm {
		font-size: 0.95rem;
	}

	.tile-name-display {
		font-family: var(--font-display);
		font-size: 1.6rem;
		line-height: 1.15;
		margin: 0;
	}

	.tile-desc {
		font-family: var(--font-sans);
		font-size: 0.8rem;
		line-height: 1.45;
		color: var(--text-secondary);
		margin: 0.25rem 0 0;
	}

	.on-accent .tile-desc {
		color: rgba(255, 255, 255, 0.85);
	}

	.tag {
		display: inline-flex;
		align-items: center;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		font-weight: 500;
		background: var(--accent-neutral-chip);
		color: var(--text-secondary);
		border-radius: 3px;
		padding: 0.2rem 0.5rem;
	}

	.on-default .tag {
		background: color-mix(in srgb, var(--accent-default-on) 12%, transparent);
		color: var(--accent-default-on);
	}

	.tag-neutral {
		background: var(--accent-neutral-chip);
	}

	.icon {
		width: 22px;
		height: 22px;
		stroke-width: 1.7;
		fill: none;
		stroke-linecap: round;
		stroke-linejoin: round;
		color: var(--text-primary);
	}

	.icon-lg {
		width: 30px;
		height: 30px;
		flex-shrink: 0;
	}

	.tile-json {
		grid-area: json;
		padding: 20px;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
	}

	/* The palette tile is the real, functional search field — a slim input
	   pill up top, the big "Type it. Find any tool." headline underneath,
	   exactly as landing-design.md §2's mockup draws it (not merged into
	   one single-line search bar). Keeps the on-default semantic role so
	   it still inverts correctly in dark mode. */
	.tile-palette {
		grid-area: palette;
		padding: 28px;
		display: flex;
		flex-direction: column;
		gap: var(--space-6);
	}

	.palette-input {
		display: block;
		width: 100%;
		height: 2.5rem;
		box-sizing: border-box;
		padding: 0 0.85rem;
		border: none;
		border-radius: var(--radius-default);
		background: color-mix(in srgb, var(--accent-default-on) 10%, transparent);
		color: inherit;
		font-family: var(--font-mono);
		font-size: 0.85rem;
		outline: none;
	}

	.palette-input:focus-visible {
		outline: 2px solid var(--accent-signature);
		outline-offset: 2px;
	}

	.palette-input::placeholder {
		color: color-mix(in srgb, currentColor 55%, transparent);
	}

	.tile-hash {
		grid-area: hash;
		padding: 20px;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
	}

	.tile-square {
		padding: 16px;
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.tile-uuid {
		grid-area: uuid;
	}

	.tile-jwt {
		grid-area: jwt;
	}

	.tile-base64 {
		grid-area: base64;
		padding: 18px;
	}

	.tile-cron {
		grid-area: cron;
		padding: 18px;
	}

	.tile-ocr {
		grid-area: ocr;
		padding: 18px;
	}

	.tile-pdf {
		grid-area: pdf;
		padding: 18px;
	}

	.tile-images {
		grid-area: images;
		padding: 20px 24px;
		display: flex;
		align-items: center;
		gap: 20px;
	}

	.tile-images-text {
		flex-shrink: 0;
	}

	.tile-images-tags {
		flex: 1;
		display: flex;
		justify-content: flex-end;
		gap: 8px;
		flex-wrap: wrap;
	}

	/* Tablet — same bento, reflowed to 3 columns; Hash loses its "tall"
	   treatment (still orange, still ghost-glyphed) per landing-design.md §2. */
	@media (min-width: 768px) and (max-width: 1023px) {
		.bento-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			grid-template-areas:
				'json    palette palette'
				'json    uuid    jwt'
				'hash    base64  cron'
				'ocr     pdf     pdf'
				'images  images  images';
		}

		.tile-hash {
			display: flex;
			flex-direction: column;
			justify-content: flex-end;
			padding: 18px;
		}
	}

	/* Mobile — bento gives way to a horizontal-scroll strip (confirmed
	   unchanged, landing-design.md §2: bento doesn't translate to 390px). */
	.mobile-strip {
		display: none;
	}

	@media (max-width: 767px) {
		.bento-grid {
			display: none;
		}

		.mobile-strip {
			display: flex;
			gap: var(--space-3);
			margin: var(--space-8) calc(var(--space-6) * -1) 0;
			padding: 0 var(--space-6) var(--space-2);
			overflow-x: auto;
			scroll-snap-type: x mandatory;
			list-style: none;
		}

		.mobile-strip-card {
			flex: 0 0 auto;
			width: 9rem;
			scroll-snap-align: start;
			border: 1px solid var(--border-hairline);
			border-radius: var(--radius-lg);
			background: var(--bg-surface);
		}

		.mobile-strip-card .card-link {
			display: block;
			padding: var(--space-4);
			text-decoration: none;
			color: inherit;
		}

		.mobile-strip-card .tool-icon {
			display: inline-block;
			font-family: var(--font-mono);
			font-size: var(--type-caption);
			font-weight: 700;
			letter-spacing: 0.03em;
			background: var(--bg-base);
			border: 1px solid var(--border-hairline);
