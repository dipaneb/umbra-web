---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

// Hybrid content model (landing-ia.md §5): version/date are read live from
// the GitHub Releases API at build time; the Added/Changed/Fixed summaries
// are curated by hand (src/content/changelog/*.json) and never auto-generated
// from a release's raw body (Step 2.1's "like a language/framework changelog"
// call) — a plausible-looking automated summary is still self-reported, just
// by a script instead of a person.
const curatedEntries = await getCollection('changelog');
const curated = new Map(curatedEntries.map((entry) => [entry.id, entry.data]));

let liveReleases: { tag: string; date: string }[] = [];
try {
	const res = await fetch('https://api.github.com/repos/dipaneb/umbra/releases');
	if (res.ok) {
		const data = await res.json();
		liveReleases = data
			.filter((r: { draft: boolean; prerelease: boolean }) => !r.draft && !r.prerelease)
			.map((r: { tag_name: string; published_at: string }) => ({ tag: r.tag_name, date: r.published_at }));
	}
} catch {
	// keep liveReleases empty — every entry below falls back to its own
	// fallbackDate, so the page still renders for an offline build.
}
const liveDateByTag = new Map(liveReleases.map((r) => [r.tag, r.date]));

const curatedDisplay = [...curated.entries()].map(([tag, data]) => ({
	tag,
	date: liveDateByTag.get(tag) ?? data.fallbackDate,
	pending: false as const,
	...data,
}));

// A live release newer than the newest curated entry is real curation lag —
// shown as a visible "coming soon" gap rather than silently dropped or
// blocking the build. A live release *older* than the curated range (the
// three earliest tags, which shipped placeholder release notes with nothing
// to categorize) stays omitted, matching this page's original deliberate cut.
const newestCuratedTime = Math.max(...curatedDisplay.map((entry) => new Date(entry.date).getTime()));
const pendingEntries = liveReleases
	.filter((r) => !curated.has(r.tag) && new Date(r.date).getTime() > newestCuratedTime)
	.map((r) => ({ tag: r.tag, date: r.date, pending: true as const }));

const entries = [...curatedDisplay, ...pendingEntries].sort(
	(a, b) => new Date(b.date).getTime() - new Date(a.date).getTime(),
);

function formatDate(iso: string) {
	// UTC explicitly — this runs at build time, and the release date shouldn't
	// shift by a day depending on which timezone the build happens to run in.
	return new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
}
---

<Layout
	title="Changelog"
	description="What's shipped in Umbra, release by release, pulled directly from GitHub — added, changed, fixed."
>
	<section class="section container prose changelog-page">
		<h1>Changelog</h1>
		<p class="page-lede">What's shipped, pulled straight from GitHub releases.</p>

		{
			entries.map((entry) => (
				<article class="entry">
					<h2>
						{entry.tag} — {formatDate(entry.date)}
					</h2>
					{entry.pending ? (
						<p class="pending-note">Release notes coming soon.</p>
					) : (
						<>
							{entry.added && (
								<div class="category">
									<h3>Added</h3>
									<ul>{entry.added.map((line) => <li>{line}</li>)}</ul>
								</div>
							)}
							{entry.changed && (
								<div class="category">
									<h3>Changed</h3>
									<ul>{entry.changed.map((line) => <li>{line}</li>)}</ul>
								</div>
							)}
							{entry.fixed && (
								<div class="category">
									<h3>Fixed</h3>
									<ul>{entry.fixed.map((line) => <li>{line}</li>)}</ul>
								</div>
							)}
						</>
					)}
				</article>
			))
		}

		<p class="full-notes">
			<a href="https://github.com/dipaneb/umbra/releases">Full release notes on GitHub.</a>
		</p>
	</section>
</Layout>

<style>
	.changelog-page {
		max-width: 42rem;
	}

	.entry {
		border-top: 1px solid var(--border-hairline);
		padding: var(--space-6) 0;
	}

	.entry h2 {
		font-family: var(--font-mono);
		font-size: var(--type-h3);
		margin-bottom: var(--space-3);
	}

	.category h3 {
		font-size: var(--type-caption);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--text-secondary);
		margin: var(--space-3) 0 var(--space-1);
	}

	.full-notes {
		margin-top: var(--space-8);
	}

	.pending-note {
		color: var(--text-secondary);
		font-style: italic;
	}
</style>
