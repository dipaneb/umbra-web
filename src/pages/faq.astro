---
import Layout from '../layouts/Layout.astro';

const faqs = [
	{
		id: 'open-source',
		q: 'Is Umbra open source?',
		a: "No. Umbra's code is public — you can read it on GitHub — but its license is All Rights Reserved, not an open-source license. You're welcome to look, but not to reuse or fork it.",
	},
	{
		id: 'network',
		q: 'What does Umbra send over the network?',
		a: 'Exactly one thing: an automatic check for app updates. That check is disclosed in the app itself (Settings) and in the README, not just here. Installing an update always asks for your explicit confirmation first — nothing installs silently.',
	},
	{
		id: 'analytics',
		q: 'Does Umbra track me?',
		a: "The app has no telemetry, analytics, or tracking of any kind — verified before every release with a network-monitor check, not just claimed. This website (umbra-web) is different: it uses PostHog for anonymous page-view counts, with session recording turned off. That's this site's analytics, not the app's.",
	},
	{
		id: 'platforms',
		q: 'What platforms does Umbra support?',
		a: 'macOS on Apple Silicon (M-series chips) today. There is no Intel Mac, Windows, or Linux build yet.',
	},
	{
		id: 'verified',
		q: 'How do I know the privacy claim is actually true?',
		a: "Every release goes through a written, executed checklist that captures a live network trace of the app and confirms the only connection made is the disclosed update check — not just a one-time audit, a per-release gate.",
	},
	{
		id: 'tools',
		q: 'What tools are in Umbra?',
		a: 'JSON formatting/validation, Base64 encode/decode, UUID generation, hashing, JWT decoding, cron expression translation, and image-to-text (OCR) — all running locally.',
	},
];
---

<Layout
	title="FAQ"
	description="Answers about Umbra's privacy model, license, supported platforms, and what this website's analytics does and doesn't collect."
>
	<section class="faq">
		<h1>Frequently asked questions</h1>
		<dl>
			{
				faqs.map((item) => (
					<div class="faq-item" id={item.id}>
						<dt>{item.q}</dt>
						<dd>{item.a}</dd>
					</div>
				))
			}
		</dl>
	</section>
</Layout>

<style>
	.faq {
		max-width: 42rem;
		margin: 0 auto;
		padding: 4rem 1.5rem;
	}

	.faq h1 {
		margin-bottom: 2rem;
	}

	.faq dl {
		margin: 0;
	}

	.faq-item {
		padding: 1.5rem 0;
		border-top: 1px solid var(--color-border);
		scroll-margin-top: 5rem;
	}

	.faq-item:last-child {
		border-bottom: 1px solid var(--color-border);
	}

	.faq-item dt {
		font-weight: 700;
		font-size: 1.05rem;
		margin-bottom: 0.5rem;
	}

	.faq-item dd {
		margin: 0;
		color: var(--color-text-muted);
	}
</style>
