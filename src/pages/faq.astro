---
import Layout from '../layouts/Layout.astro';
import { faqs } from '../data/faq';
---

<Layout title="FAQ" description="Is Umbra open source? Is it safe on Windows? Does it phone home? Direct answers to the most common questions.">
	<section class="section container prose faq-page">
		<h1>FAQ</h1>
		<p class="page-lede">Common questions, answered directly.</p>

		<ul class="faq-list">
			{
				faqs.map((item) => (
					<li>
						<details id={item.id}>
							<summary><h2>{item.q}</h2></summary>
							{item.id === 'comparison-to-named-competitors' ? (
								<p class="answer">
									The short version: Umbra leads with one narrow claim none of them make the same
									way — a per-release check showing zero network calls, not just a sentence
									asserting privacy. The full, sourced comparisons live on their own pages:{' '}
									<a href="/compare/devtoys/">DevToys</a>, <a href="/compare/devutils/">DevUtils</a>,{' '}
									<a href="/compare/devtools-x/">DevTools-X</a>, <a href="/compare/cyberchef/">CyberChef</a>.
								</p>
							) : item.id === 'free-online-tools' ? (
								<p class="answer">
									Because anything you paste into a web tool leaves your machine, even briefly —
									you're trusting a server you don't control and can't inspect. Umbra runs
									entirely on your device: nothing you paste, drop, or type is ever sent anywhere.
									Each tool has its own page with more on this for that specific format:{' '}
									<a href="/tools/json/">JSON</a>, <a href="/tools/base64/">Base64</a>,{' '}
									<a href="/tools/uuid/">UUID</a>, <a href="/tools/hash/">Hash</a>,{' '}
									<a href="/tools/jwt/">JWT</a>, <a href="/tools/cron/">Cron</a>,{' '}
									<a href="/tools/ocr/">Image to Text</a>, <a href="/tools/pdf/">PDF</a>,{' '}
									<a href="/tools/image/">Images</a>.
								</p>
							) : (
								<p class="answer">{item.a}</p>
							)}
						</details>
					</li>
				))
			}
		</ul>
	</section>
</Layout>

<style>
	.faq-page {
		max-width: 42rem;
	}
</style>
