---
import { getCollection } from 'astro:content';
import ToolPage from '../../../components/ToolPage.astro';

export async function getStaticPaths() {
	const tools = await getCollection('tools', ({ id }) => id.startsWith('fr/'));
	return tools.map((tool) => ({
		params: { id: tool.id.replace(/^fr\//, '') },
		props: { tool },
	}));
}

const { tool } = Astro.props;
const { name, seoTitle, seoDescription, directAnswer, body, screenshotSlug, screenshotAlt, faqs } = tool.data;
---

<ToolPage
	lang="fr"
	title={seoTitle}
	description={seoDescription}
	name={name}
	directAnswer={directAnswer}
	body={body}
	screenshotSlug={screenshotSlug}
	screenshotAlt={screenshotAlt}
	faqs={faqs}
/>
